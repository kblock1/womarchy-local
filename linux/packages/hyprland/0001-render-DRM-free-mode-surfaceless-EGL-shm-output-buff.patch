 }
 
-void CHyprOpenGLImpl::initEGL(bool gbm) {
+void CHyprOpenGLImpl::initEGL(eEGLPlatform platform) {
     std::vector<EGLint> attrs;
     if (m_exts.KHR_display_reference) {
         attrs.push_back(EGL_TRACK_REFERENCES_KHR);
@@ -158,7 +158,14 @@ void CHyprOpenGLImpl::initEGL(bool gbm) {
 
     attrs.push_back(EGL_NONE);
 
-    m_eglDisplay = m_proc.eglGetPlatformDisplayEXT(gbm ? EGL_PLATFORM_GBM_KHR : EGL_PLATFORM_DEVICE_EXT, gbm ? m_gbmDevice : m_eglDevice, attrs.data());
+    switch (platform) {
+        case EGL_PLATFORM_KIND_GBM: m_eglDisplay = m_proc.eglGetPlatformDisplayEXT(EGL_PLATFORM_GBM_KHR, m_gbmDevice, attrs.data()); break;
+        case EGL_PLATFORM_KIND_SURFACELESS:
+            m_eglDisplay = m_proc.eglGetPlatformDisplayEXT(EGL_PLATFORM_SURFACELESS_MESA, EGL_DEFAULT_DISPLAY, attrs.data());
+            break;
+        case EGL_PLATFORM_KIND_DEVICE:
+        default: m_eglDisplay = m_proc.eglGetPlatformDisplayEXT(EGL_PLATFORM_DEVICE_EXT, m_eglDevice, attrs.data()); break;
+    }
     if (m_eglDisplay == EGL_NO_DISPLAY)
         RASSERT(false, "EGL: failed to create a platform display");
 
@@ -330,12 +337,20 @@ CHyprOpenGLImpl::CHyprOpenGLImpl() : m_drmFD(g_pCompositor->m_drmRenderNode.fd >
     RASSERT(eglBindAPI(EGL_OPENGL_ES_API) != EGL_FALSE, "Couldn't bind to EGL's opengl ES API. This means your gpu driver f'd up. This is not a hyprland issue.");
 
     bool success = false;
-    if (EGLEXTENSIONS.contains("EXT_platform_device") || !m_proc.eglQueryDevicesEXT || !m_proc.eglQueryDeviceStringEXT) {
+    if (m_drmFD < 0) {
+        // No DRM device (e.g. WSL2): render on Mesa's surfaceless platform, which picks the
+        // software-winsys loader and thus any GPU driver that doesn't need a DRM node (d3d12).
+        // Output buffers are then CPU buffers that we read back into.
+        RASSERT(EGLEXTENSIONS.contains("EGL_MESA_platform_surfaceless"), "No DRM device and EGL_MESA_platform_surfaceless is unsupported, cannot render.");
+        Log::logger->log(Log::DEBUG, "EGL: no DRM device, using the surfaceless platform");
+        success = true;
+        initEGL(EGL_PLATFORM_KIND_SURFACELESS);
+    } else if (EGLEXTENSIONS.contains("EXT_platform_device") || !m_proc.eglQueryDevicesEXT || !m_proc.eglQueryDeviceStringEXT) {
         m_eglDevice = eglDeviceFromDRMFD(m_drmFD);
 
         if (m_eglDevice != EGL_NO_DEVICE_EXT) {
             success = true;
-            initEGL(false);
+            initEGL(EGL_PLATFORM_KIND_DEVICE);
         }
     }
 
@@ -351,7 +366,7 @@ CHyprOpenGLImpl::CHyprOpenGLImpl() : m_drmFD(g_pCompositor->m_drmRenderNode.fd >
             if (!m_gbmDevice)
                 RASSERT(false, "Couldn't open a gbm device");
 
-            initEGL(true);
+            initEGL(EGL_PLATFORM_KIND_GBM);
         }
     }
 
