diff --git a/src/render/gl/GLRenderbuffer.cpp b/src/render/gl/GLRenderbuffer.cpp
index 794d035..052fbc1 100644
--- a/src/render/gl/GLRenderbuffer.cpp
+++ b/src/render/gl/GLRenderbuffer.cpp
@@ -10,6 +10,7 @@
 #include <hyprutils/signal/Signal.hpp>
 
 #include <dlfcn.h>
+#include <hyprgraphics/egl/Egl.hpp>
 
 using namespace Render::GL;
 
@@ -34,6 +35,11 @@ CGLRenderbuffer::~CGLRenderbuffer() {
 CGLRenderbuffer::CGLRenderbuffer(SP<Aquamarine::IBuffer> buffer, uint32_t format) : IRenderbuffer(buffer, format) {
     auto dma = buffer->dmabuf();
 
+    if (!dma.success && buffer->shm().success) {
+        initShm(buffer);
+        return;
+    }
+
     m_image = g_pHyprOpenGL->createEGLImage(dma);
     if (m_image == EGL_NO_IMAGE_KHR) {
         Log::logger->log(Log::ERR, "rb: createEGLImage failed");
@@ -73,3 +79,88 @@ void CGLRenderbuffer::bind() {
 void CGLRenderbuffer::unbind() {
     GLFB(m_framebuffer)->unbind();
 }
+
+void CGLRenderbuffer::initShm(SP<Aquamarine::IBuffer> buffer) {
+    // No way to import a CPU buffer as a render target: render into a GPU texture instead and
+    // read the damaged pixels back into the buffer after every frame (see readbackToBuffer).
+    const auto shm = buffer->shm();
+
+    m_shm         = true;
+    m_framebuffer = makeShared<CGLFramebuffer>("shm output buffer");
+    if (!m_framebuffer->alloc(shm.size.x, shm.size.y, shm.format)) {
+        Log::logger->log(Log::ERR, "rb: failed to allocate a framebuffer for a shm buffer");
+        return;
+    }
+
+    m_listeners.destroyBuffer = buffer->events.destroy.listen([this] { g_pHyprRenderer->onRenderbufferDestroy(this); });
+
+    m_good = true;
+}
+
+void CGLRenderbuffer::readbackToBuffer(const CRegion& damage) {
+    if (!m_shm || !m_good)
+        return;
+
+    if (!g_pHyprOpenGL->m_exts.EXT_read_format_bgra) {
+        static bool warned = false;
+        if (!std::exchange(warned, true))
+            Log::logger->log(Log::ERR, "shm output: GL_EXT_read_format_bgra is missing, can't read frames back");
+        return;
+    }
+
+    const auto buffer = m_hlBuffer.lock();
+    if (!buffer)
+        return;
+
+    const auto shm                = buffer->shm();
+    auto [pixelData, fmt, bufLen] = buffer->beginDataPtr(0);
+    const auto PFORMAT            = Hyprgraphics::Egl::getPixelFormatFromDRM(shm.format);
+    if (!pixelData || !PFORMAT || shm.stride <= 0) {
+        buffer->endDataPtr();
+        return;
+    }
+
+    CRegion region = damage.copy().intersect(CBox{{}, shm.size});
+    if (region.empty()) {
+        buffer->endDataPtr();
+        return;
+    }
+
+    // every glReadPixels is a GPU sync point with a fixed cost; don't pay it per tiny rect
+    if (region.getRects().size() > 4)
+        region = CRegion{region.getExtents()};
+
+    // same format selection as CGLFramebuffer::readPixels
+    static auto stripSwizzleAlpha = [](std::array<GLint, 4> arr) {
+        arr[3] = GL_ONE;
+        return arr;
+    };
+
+    int glFormat = PFORMAT->glFormat;
+    if (PFORMAT->swizzle.has_value()) {
+        if (stripSwizzleAlpha(*PFORMAT->swizzle) == stripSwizzleAlpha(Hyprgraphics::Egl::SWIZZLE_BGRA))
+            glFormat = GL_BGRA_EXT;
+        else
+            glFormat = GL_RGBA;
+    } else if (glFormat == GL_RGBA)
+        glFormat = GL_BGRA_EXT;
+
+    g_pHyprOpenGL->makeEGLCurrent();
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, GLFB(m_framebuffer)->getFBID());
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glPixelStorei(GL_PACK_ROW_LENGTH, shm.stride / 4);
+
+    region.forEachRect([&](const auto& rect) {
+        const int w = rect.x2 - rect.x1;
+        const int h = rect.y2 - rect.y1;
+        if (w <= 0 || h <= 0)
+            return;
+
+        glReadPixels(rect.x1, rect.y1, w, h, glFormat, PFORMAT->glType, pixelData + sc<size_t>(rect.y1) * shm.stride + sc<size_t>(rect.x1) * 4);
+    });
+
+    glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+    glPixelStorei(GL_PACK_ALIGNMENT, 4);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+    buffer->endDataPtr();
+}
