diff --git a/src/output/Monitor.cpp b/src/output/Monitor.cpp
index e69d8dd..addd5af 100644
--- a/src/output/Monitor.cpp
+++ b/src/output/Monitor.cpp
@@ -2644,6 +2644,8 @@ void CMonitorState::ensureBufferPresent() {
     if (STATE.buffer) {
         if (const auto params = STATE.buffer->dmabuf(); params.success && params.format == m_owner->m_drmFormat)
             return;
+        if (const auto shm = STATE.buffer->shm(); shm.success && shm.format == m_owner->m_drmFormat && shm.size == m_owner->m_pixelSize)
+            return;
     }
 
     // this is required for modesetting being possible and might be missing in case of first tests in the renderer
@@ -2686,13 +2688,19 @@ bool CMonitorState::updateSwapchain() {
         return true;
     }
 
-    if (OPTIONS.format == m_owner->m_drmFormat && OPTIONS.scanout && OPTIONS.length == 3 && OPTIONS.size == MODE->pixelSize)
+    // CPU (shm) output buffers are filled by a synchronous readback and handed to the backend, which has
+    // at most one frame in flight: double buffering is enough. A third buffer would only cost memory,
+    // allocation time (slow on shared-memory filesystems) and a larger damage area (buffer age).
+    const auto   ALLOC  = m_owner->m_output->getBackend()->preferredAllocator();
+    const size_t LENGTH = ALLOC && ALLOC->type() == Aquamarine::AQ_ALLOCATOR_TYPE_SHM ? 2 : 3;
+
+    if (OPTIONS.format == m_owner->m_drmFormat && OPTIONS.scanout && OPTIONS.length == LENGTH && OPTIONS.size == MODE->pixelSize)
         return true;
 
     auto options    = OPTIONS;
     options.format  = m_owner->m_drmFormat;
     options.scanout = true;
-    options.length  = 3;
+    options.length  = LENGTH;
     options.size    = MODE->pixelSize;
     return m_owner->m_output->swapchain->reconfigure(options);
 }
diff --git a/src/render/GLRenderer.cpp b/src/render/GLRenderer.cpp
index 1dab5a0..eca57b4 100644
--- a/src/render/GLRenderer.cpp
+++ b/src/render/GLRenderer.cpp
@@ -105,8 +105,18 @@ void CHyprGLRenderer::endRender(const std::function<void()>& renderingDoneCallba
     if (m_renderMode == RENDER_MODE_FULL_FAKE)
         return;
 
-    if (m_renderMode == RENDER_MODE_NORMAL)
+    if (m_renderMode == RENDER_MODE_NORMAL) {
+        // CPU (shm) output buffers can't be rendered to directly; copy the updated pixels over
+        if (m_currentRenderbuffer) {
+            // render damage is in output coordinates; the buffer is untransformed (as in frameDamage)
+            CRegion bufferDamage = g_pHyprRenderer->m_renderData.damage.copy();
+            bufferDamage.transform(Math::wlTransformToHyprutils(Math::invertTransform(PMONITOR->m_transform)), PMONITOR->m_transformedSize.x,
+                                   PMONITOR->m_transformedSize.y);
+            m_currentRenderbuffer->readbackToBuffer(bufferDamage);
+        }
+
         PMONITOR->m_output->state->setBuffer(m_currentBuffer);
+    }
 
     if (!explicitSyncSupported()) {
         Log::logger->log(Log::TRACE, "renderer: Explicit sync unsupported, falling back to implicit in endRender");
