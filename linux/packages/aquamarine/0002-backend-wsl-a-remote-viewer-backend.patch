+#include <aquamarine/backend/Wsl.hpp>
+#include <aquamarine/allocator/Shm.hpp>
+#include "wsl/wdp.h"
+#include "Shared.hpp"
+#include "FormatUtils.hpp"
+
+#include <algorithm>
+#include <cerrno>
+#include <charconv>
+#include <cmath>
+#include <csignal>
+#include <cstring>
+#include <ctime>
+#include <fcntl.h>
+#include <format>
+#include <linux/input-event-codes.h>
+#include <linux/vm_sockets.h>
+#include <optional>
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/timerfd.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+using namespace Aquamarine;
+using namespace Hyprutils::Memory;
+using namespace Hyprutils::Math;
+#define SP CSharedPointer
+#define WP CWeakPointer
+
+using Clock = std::chrono::steady_clock;
+
+// No viewer, or the output's window is hidden: keep clients ticking, slowly.
+static constexpr auto IDLE_FRAME_INTERVAL = std::chrono::seconds(1);
+// If a frame's ack hasn't arrived after this, read the socket once more: hv_sock has been seen to wake
+// a reader late (WSL 3.0.1), and this costs one timer per frame instead of a constant poll.
+static constexpr auto LATE_ACK_POLL = std::chrono::milliseconds(25);
+// A frame never acknowledged counts as presented after this, so one lost ack can't freeze an output.
+static constexpr auto ACK_TIMEOUT = std::chrono::milliseconds(250);
+// A new connection must authenticate within this.
+static constexpr auto HELLO_TIMEOUT = std::chrono::seconds(5);
+// Total time one message may take to write before the viewer is considered gone.
+static constexpr int WRITE_TIMEOUT_MS = 2000;
+
+static bool wslTrace() {
+    static const bool TRACE = envEnabled("WOMARCHY_TRACE");
+    return TRACE;
+}
+
+static double nowMsF() {
+    return std::chrono::duration<double, std::milli>(Clock::now().time_since_epoch()).count();
+}
+
+static std::string envOr(const char* name, const char* fallback = "") {
+    const char* v = getenv(name);
+    return v ? v : fallback;
+}
+
+static std::optional<uint32_t> parseU32(std::string_view s) {
+    uint32_t v = 0;
+    auto [end, ec] = std::from_chars(s.data(), s.data() + s.size(), v);
+    if (ec != std::errc{} || end != s.data() + s.size())
+        return std::nullopt;
+    return v;
+}
+
+static std::optional<int32_t> parseI32(std::string_view s) {
+    int32_t v = 0;
+    auto [end, ec] = std::from_chars(s.data(), s.data() + s.size(), v);
+    if (ec != std::errc{} || end != s.data() + s.size())
+        return std::nullopt;
+    return v;
+}
+
+// 64 hex characters -> 32 bytes
+static std::optional<std::array<uint8_t, 32>> parseToken(const std::string& hex) {
+    std::array<uint8_t, 32> out{};
+    if (hex.size() != out.size() * 2)
+        return std::nullopt;
+    for (size_t i = 0; i < out.size(); ++i) {
+        auto [end, ec] = std::from_chars(hex.data() + i * 2, hex.data() + i * 2 + 2, out[i], 16);
+        if (ec != std::errc{} || end != hex.data() + i * 2 + 2)
+            return std::nullopt;
+    }
+    return out;
+}
+
+// compare secrets without leaking where they differ
+static bool sameBytes(const uint8_t* a, const uint8_t* b, size_t n) {
+    uint8_t diff = 0;
+    for (size_t i = 0; i < n; ++i)
+        diff |= a[i] ^ b[i];
+    return diff == 0;
+}
+
+template <typename T>
+static bool readStruct(T& out, const uint8_t* data, uint32_t size) {
+    if (size < sizeof(T))
+        return false;
+    memcpy(&out, data, sizeof(T));
+    return true;
+}
+
+// ---------------------------------------------------------------- output
+
+Aquamarine::CWslOutput::CWslOutput(const std::string& name_, uint32_t id, WP<CWslBackend> wsl_) : monitorID(id), wsl(wsl_) {
+    name        = name_;
+    description = std::format("womarchy viewer monitor {}", id);
+    make        = "womarchy";
+    model       = "WSL viewer";
+}
+
+Aquamarine::CWslOutput::~CWslOutput() {
+    events.destroy.emit();
+}
+
+void Aquamarine::CWslOutput::updateMode(const Vector2D& size, uint32_t refreshmHz) {
+    modes.clear();
+    modes.emplace_back(SP<SOutputMode>(new SOutputMode{.pixelSize = size, .refreshRate = refreshmHz, .preferred = true}));
+}
+
+std::chrono::nanoseconds Aquamarine::CWslOutput::refreshPeriod() {
+    const auto& st   = state->state();
+    uint32_t    mHz  = 0;
+    if (auto mode = st.mode.lock())
+        mHz = mode->refreshRate;
+    else if (st.customMode)
+        mHz = st.customMode->refreshRate;
+    else if (!modes.empty())
+        mHz = modes.front()->refreshRate;
+    if (mHz < 1000)
+        mHz = 60000;
+    return std::chrono::nanoseconds(1000000000000LL / mHz);
+}
+
+bool Aquamarine::CWslOutput::commit() {
+    auto        snapshot = state->snapshot();
+    const auto& st       = snapshot.state();
+    const auto  BUFFER   = (st.committed & COutputState::AQ_OUTPUT_STATE_BUFFER) ? st.buffer : nullptr;
+    CRegion     damage   = st.damage;
+
+    events.commit.emit();
+    state->consume(snapshot);
+    needsFrame = false;
+
+    auto backend = wsl.lock();
+    if (BUFFER && backend && backend->connected() && backend->sendFrame(self.lock(), BUFFER, damage)) {
+        frameInFlight = true; // present + next frame once the viewer acks
+        const auto SEQ  = seq;
+        const auto NOW  = Clock::now();
+        auto       late = makeShared<std::function<void()>>([weak = self, SEQ]() {
+            if (!weak || !weak->frameInFlight || weak->seq != SEQ)
+                return;
+            if (auto b = weak->wsl.lock(); b && b->clientFD.isValid())
+                b->readClient();
+        });
+        auto lost = makeShared<std::function<void()>>([weak = self, SEQ]() {
+            if (!weak || !weak->frameInFlight || weak->seq != SEQ)
+                return;
+            if (auto b = weak->wsl.lock())
+                b->aq->log(AQ_LOG_WARNING, std::format("wsl: {} frame {} was never acknowledged; continuing", weak->name, SEQ));
+            weak->onFrameDone(SEQ);
+        });
+        backend->addTimer(NOW + std::max<std::chrono::nanoseconds>(LATE_ACK_POLL, refreshPeriod() * 3 / 2), late);
+        backend->addTimer(NOW + ACK_TIMEOUT, lost);
+        return true;
+    }
+
+    timespec now{};
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    events.present.emit(IOutput::SPresentEvent{.presented = true, .when = &now});
+    return true;
+}
+
+bool Aquamarine::CWslOutput::test() {
+    return true;
+}
+
+SP<IBackendImplementation> Aquamarine::CWslOutput::getBackend() {
+    return wsl.lock();
+}
+
+// Emit a frame event: right away if the last one was at least ~one refresh period ago (never faster than
+// the monitor), otherwise when it is due; slowly while there is no viewer or the window is hidden.
+void Aquamarine::CWslOutput::queueFrame() {
+    auto backend = wsl.lock();
+    if (!backend)
+        return;
+
+    if (!framecb) {
+        framecb = makeShared<std::function<void()>>([this, weak = self]() {
+            if (!weak)
+                return;
+            frameScheduled = false;
+            if (frameInFlight) {
+                needsFrame = true; // a frame raced ahead of the viewer; render once it acks
+                return;
+            }
+            lastFrame = Clock::now();
+            if (auto b = wsl.lock(); b && wslTrace())
+                b->aq->log(AQ_LOG_DEBUG, std::format("wsl-trace {:.2f} {} frame event", nowMsF(), name));
+            events.frame.emit();
+        });
+    }
+
+    frameScheduled = true;
+    const auto INTERVAL = backend->connected() && visible ? std::chrono::duration_cast<std::chrono::nanoseconds>(refreshPeriod() * 9 / 10) :
+                                                            std::chrono::duration_cast<std::chrono::nanoseconds>(IDLE_FRAME_INTERVAL);
+    const auto DUE      = lastFrame + INTERVAL;
+    if (Clock::now() >= DUE)
+        backend->aq->addIdleEvent(framecb);
+    else
+        backend->addTimer(DUE, framecb);
+}
+
+void Aquamarine::CWslOutput::scheduleFrame(const scheduleFrameReason reason) {
+    if (auto b = wsl.lock(); b && wslTrace())
+        b->aq->log(AQ_LOG_DEBUG,
+                   std::format("wsl-trace {:.2f} {} scheduleFrame reason {} scheduled {} inflight {}", nowMsF(), name, (uint32_t)reason, frameScheduled, frameInFlight));
+    needsFrame = true;
+
+    // with a viewer, frames are paced by its acknowledgements (display vblank)
+    if (frameScheduled || frameInFlight)
+        return;
+
+    queueFrame();
+}
+
+void Aquamarine::CWslOutput::onFrameDone(uint64_t doneSeq) {
+    if (!frameInFlight || doneSeq != seq)
+        return;
+
+    frameInFlight = false;
+    if (auto b = wsl.lock(); b && wslTrace())
+        b->aq->log(AQ_LOG_DEBUG, std::format("wsl-trace {:.2f} {} ack seq {} needsFrame {}", nowMsF(), name, doneSeq, needsFrame));
+
+    timespec now{};
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    events.present.emit(IOutput::SPresentEvent{
+        .presented = true,
+        .when      = &now,
+        .refresh   = (int)refreshPeriod().count(),
+        .flags     = AQ_OUTPUT_PRESENT_VSYNC,
+    });
+
+    if (needsFrame && !frameScheduled)
+        queueFrame();
+}
+
+bool Aquamarine::CWslOutput::destroy() {
+    auto       backend = wsl.lock();
+    const auto ID      = monitorID;
+    events.destroy.emit();
+    if (!backend)
+        return true;
+
+    if (backend->connected()) {
+        wdp_output_removed msg{.output_id = ID};
+        backend->send(WDP_OUTPUT_REMOVED, &msg, sizeof(msg));
+    }
+    std::erase_if(backend->monitorSpecs, [ID](const auto& m) { return m.id == ID; });
+    std::erase_if(backend->outputs, [ID](const auto& o) { return o->monitorID == ID; }); // may release `this`
+    backend->updateCursor();
+    return true;
+}
