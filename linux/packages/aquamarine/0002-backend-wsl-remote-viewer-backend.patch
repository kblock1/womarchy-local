+
+        // networking
+        bool                                  listenSocket();
+        void                                  acceptClient();
+        void                                  readClient();
+        void                                  dropClient(const std::string& why);
+        void                                  handleMessage(uint32_t type, const uint8_t* data, uint32_t size);
+        bool                                  send(uint32_t type, const void* payload, size_t size, const void* extra = nullptr, size_t extraSize = 0);
+        bool                                  writeAll(const uint8_t* data, size_t size);
+        bool                                  connected() const;
+        void                                  updateAckPoll();
+        void                                  onAckPoll();
