+        void                                  releaseAllInput();
+        uint32_t                              nowMs() const;
+
+        Hyprutils::Memory::CWeakPointer<CBackend>                     backend;
+        Hyprutils::Memory::CSharedPointer<CShmAllocator>              allocator;
+        std::vector<Hyprutils::Memory::CSharedPointer<CWslOutput>>    outputs;
+        Hyprutils::Memory::CSharedPointer<CWslKeyboard>               keyboard;
+        Hyprutils::Memory::CSharedPointer<CWslPointer>                pointer;
+        std::vector<SMonitorSpec>                                     initialMonitors;
+
+        Hyprutils::OS::CFileDescriptor                                listenFD, clientFD, timerFD, ackPollFD;
+        bool                                                          ackPollArmed = false;
+        std::vector<uint8_t>                                          rxBuffer, txBuffer;
+        bool                                                          authenticated = false;
+        uint32_t                                                      transport     = 0;
+        std::string                                                   token, vmID, shmDir;
+        uint32_t                                                      vsockPort = 0;
+        std::string                                                   unixPath;
+        uint32_t                                                      orphanTimeoutS = 0;
+        uint64_t                                                      orphanGeneration = 0;
+
+        struct STimer {
+            std::chrono::steady_clock::time_point                    when;
+            Hyprutils::Memory::CSharedPointer<std::function<void()>> what;
+        };
+        std::vector<STimer>                                           timers;
+
+        std::set<uint32_t>                                            pressedKeys, pressedButtons;
+
+        struct {
+            bool                                              visible = true;
+            Hyprutils::Memory::CSharedPointer<IBuffer>        buffer;
