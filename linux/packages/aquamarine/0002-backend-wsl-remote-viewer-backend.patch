+
+        Hyprutils::Memory::CWeakPointer<CWslOutput>                       self;
+        uint32_t                                                          monitorID = 0;
+
+      private:
+        CWslOutput(const std::string& name_, uint32_t id, Hyprutils::Memory::CWeakPointer<CWslBackend> backend_);
+
+        void                                                     onFrameDone(uint64_t doneSeq);
+        void                                                     queueFrame();
+        void                                                     updateMode(const Hyprutils::Math::Vector2D& size, uint32_t refreshmHz);
+
+        Hyprutils::Memory::CWeakPointer<CWslBackend>             backend;
+        Hyprutils::Memory::CSharedPointer<std::function<void()>> framecb;
+        bool                                                     frameScheduled = false;
+        bool                                                     frameInFlight  = false;
+        uint64_t                                                 seq            = 0;
+        Hyprutils::Math::Vector2D                                announcedSize;
+        std::chrono::steady_clock::time_point                    lastFrame;
+
+        friend class CWslBackend;
+    };
+
