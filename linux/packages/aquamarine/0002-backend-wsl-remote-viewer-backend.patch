+using namespace Aquamarine;
+using namespace Hyprutils::Memory;
+using namespace Hyprutils::Math;
+#define SP CSharedPointer
+#define WP CWeakPointer
+
+static constexpr auto DISCONNECTED_FRAME_INTERVAL = std::chrono::milliseconds(100); // keep clients ticking slowly with no viewer
+static constexpr int  WRITE_TIMEOUT_MS            = 1000;
+static constexpr int  MAX_FRAME_RECTS             = 32;
+
+static bool           wslTrace() {
+    static const bool TRACE = envEnabled("WOMARCHY_TRACE");
+    return TRACE;
+}
+
+static double nowMsF() {
+    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+static std::string    envOr(const char* name, const char* fallback = "") {
+    const char* v = getenv(name);
+    return v ? v : fallback;
+}
+
+static std::vector<uint8_t> hexToBytes(const std::string& hex) {
+    std::vector<uint8_t> out;
+    for (size_t i = 0; i + 1 < hex.size(); i += 2)
+        out.push_back((uint8_t)std::stoi(hex.substr(i, 2), nullptr, 16));
+    return out;
+}
+
+// ---------------------------------------------------------------- output
+
+Aquamarine::CWslOutput::CWslOutput(const std::string& name_, uint32_t id, WP<CWslBackend> backend_) : monitorID(id), backend(backend_) {
+    name        = name_;
+    description = std::format("womarchy viewer monitor {}", id);
+    make        = "womarchy";
+    model       = "WSL viewer";
+    lastFrame   = std::chrono::steady_clock::now();
+}
+
+Aquamarine::CWslOutput::~CWslOutput() {
+    events.destroy.emit();
+}
+
+void Aquamarine::CWslOutput::updateMode(const Vector2D& size, uint32_t refreshmHz) {
+    modes.clear();
+    modes.emplace_back(SP<SOutputMode>(new SOutputMode{.pixelSize = size, .refreshRate = refreshmHz, .preferred = true}));
+}
+
+bool Aquamarine::CWslOutput::commit() {
+    auto        snapshot = state->snapshot();
+    const auto& st       = snapshot.state();
+    const auto  BUFFER   = (st.committed & COutputState::AQ_OUTPUT_STATE_BUFFER) ? st.buffer : nullptr;
+    CRegion     damage   = st.damage;
+
+    events.commit.emit();
+    state->consume(snapshot);
+    needsFrame = false;
+
+    if (BUFFER && backend->connected() && backend->sendFrame(self.lock(), BUFFER, damage)) {
+        frameInFlight = true; // present + next frame once the viewer acks
+        backend->updateAckPoll();
+        return true;
+    }
+
+    timespec now{};
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    events.present.emit(IOutput::SPresentEvent{.presented = true, .when = &now});
+    return true;
+}
+
+bool Aquamarine::CWslOutput::test() {
+    return true;
+}
+
+SP<IBackendImplementation> Aquamarine::CWslOutput::getBackend() {
+    return backend.lock();
+}
+
+void Aquamarine::CWslOutput::queueFrame() {
+    if (!framecb) {
+        framecb = makeShared<std::function<void()>>([this, weak = self]() {
+            if (!weak)
+                return;
+            frameScheduled = false;
+            if (frameInFlight) {
+                needsFrame = true; // a frame raced ahead of the viewer; render once it acks
+                return;
+            }
+            lastFrame      = std::chrono::steady_clock::now();
+            if (wslTrace())
+                backend->backend->log(AQ_LOG_DEBUG, std::format("wsl-trace {:.2f} {} frame event", nowMsF(), name));
+            events.frame.emit();
+        });
+    }
+
+    frameScheduled = true;
+
+    if (backend->connected()) {
+        backend->backend->addIdleEvent(framecb);
+        return;
+    }
+
+    backend->addTimer(std::max(std::chrono::steady_clock::now(), lastFrame + DISCONNECTED_FRAME_INTERVAL), framecb);
+}
+
+void Aquamarine::CWslOutput::scheduleFrame(const scheduleFrameReason reason) {
+    if (wslTrace())
+        backend->backend->log(AQ_LOG_DEBUG, std::format("wsl-trace {:.2f} {} scheduleFrame reason {} scheduled {} inflight {}", nowMsF(), name, (uint32_t)reason, frameScheduled, frameInFlight));
+    needsFrame = true;
+
+    // with a viewer, frames are paced by its acknowledgements (display vblank)
+    if (frameScheduled || frameInFlight)
+        return;
+
+    queueFrame();
+}
+
+void Aquamarine::CWslOutput::onFrameDone(uint64_t doneSeq) {
+    if (!frameInFlight || doneSeq != seq)
+        return;
+
+    frameInFlight = false;
+    backend->updateAckPoll();
+    if (wslTrace())
+        backend->backend->log(AQ_LOG_DEBUG, std::format("wsl-trace {:.2f} {} ack seq {} needsFrame {}", nowMsF(), name, doneSeq, needsFrame));
+
+    timespec now{};
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    const uint32_t refreshmHz = state->state().mode ? state->state().mode->refreshRate : 60000;
+    events.present.emit(IOutput::SPresentEvent{
+        .presented = true,
+        .when      = &now,
+        .refresh   = refreshmHz ? (int)(1000000000000LL / refreshmHz) : 0,
+        .flags     = AQ_OUTPUT_PRESENT_VSYNC,
+    });
+
+    if (needsFrame && !frameScheduled)
+        queueFrame();
+}
+
+bool Aquamarine::CWslOutput::destroy() {
+    events.destroy.emit();
+    std::erase(backend->outputs, self.lock());
+    return true;
+}
+
+std::vector<SDRMFormat> Aquamarine::CWslOutput::getRenderFormats() {
+    return backend->getRenderFormats();
+}
+
+bool Aquamarine::CWslOutput::pendingPageFlip() {
+    return frameInFlight;
+}
+
+bool Aquamarine::CWslOutput::pendingIdleFrame() {
+    return frameScheduled;
+}
+
+bool Aquamarine::CWslOutput::setCursor(SP<IBuffer> buffer, const Vector2D& hotspot) {
+    backend->cursor.buffer  = buffer;
+    backend->cursor.hotspot = hotspot;
+    backend->cursor.visible = !!buffer;
+    backend->sendCursor(!!buffer, buffer, hotspot);
+    return true;
+}
+
+void Aquamarine::CWslOutput::moveCursor(const Vector2D& coord, bool skipSchedule) {
+    // The viewer shows the host's own cursor, which already follows the mouse.
+    ;
+}
+
+void Aquamarine::CWslOutput::setCursorVisible(bool visible) {
+    if (backend->cursor.visible == visible)
+        return;
+    backend->cursor.visible = visible;
+    backend->sendCursor(visible, nullptr, {});
+}
+
+bool Aquamarine::CWslOutput::hasCursorPlane() const {
+    static const bool SWCURSOR = envEnabled("WOMARCHY_SOFTWARE_CURSOR");
+    return !SWCURSOR;
+}
+
+Vector2D Aquamarine::CWslOutput::cursorPlaneSize() {
+    return {-1, -1}; // any size
+}
+
+const std::string& Aquamarine::CWslKeyboard::getName() {
+    return name;
+}
+
+const std::string& Aquamarine::CWslPointer::getName() {
+    return name;
+}
+
+// ---------------------------------------------------------------- backend
+
+Aquamarine::CWslBackend::CWslBackend(SP<CBackend> backend_) : backend(backend_) {
+    ;
+}
+
+Aquamarine::CWslBackend::~CWslBackend() {
+    if (connected()) {
+        wdp_bye bye{.code = 0};
+        send(WDP_BYE, &bye, sizeof(bye));
+    }
+    if (!unixPath.empty())
+        unlink(unixPath.c_str());
+}
+
+eBackendType Aquamarine::CWslBackend::type() {
+    return AQ_BACKEND_WSL;
+}
+
+std::vector<CWslBackend::SMonitorSpec> Aquamarine::CWslBackend::parseMonitorsEnv(const char* env) {
+    // "id:x:y:w:h:refresh_mhz:scale1000:primary:name;..."
+    std::vector<SMonitorSpec> out;
+    if (!env || !*env)
+        return out;
+
+    std::string all = env;
+    size_t      pos = 0;
+    while (pos < all.size()) {
+        auto end = all.find(';', pos);
+        if (end == std::string::npos)
+            end = all.size();
+        const auto               item = all.substr(pos, end - pos);
+        std::vector<std::string> f;
+        size_t                   p = 0;
+        while (true) {
+            auto c = item.find(':', p);
+            f.push_back(item.substr(p, c == std::string::npos ? std::string::npos : c - p));
+            if (c == std::string::npos)
+                break;
+            p = c + 1;
+        }
+        if (f.size() >= 8) {
+            try {
+                out.push_back(SMonitorSpec{
+                    .id         = (uint32_t)std::stoul(f[0]),
+                    .x          = std::stoi(f[1]),
+                    .y          = std::stoi(f[2]),
+                    .width      = (uint32_t)std::stoul(f[3]),
+                    .height     = (uint32_t)std::stoul(f[4]),
+                    .refreshmHz = (uint32_t)std::stoul(f[5]),
+                    .scale1000  = (uint32_t)std::stoul(f[6]),
+                    .primary    = f[7] == "1",
+                    .name       = f.size() > 8 ? f[8] : "",
+                });
+            } catch (...) { ; }
+        }
+        pos = end + 1;
+    }
+    return out;
+}
+
+bool Aquamarine::CWslBackend::start() {
+    backend->log(AQ_LOG_DEBUG, "wsl: starting the WSL (remote viewer) backend");
+
+    token     = envOr("WOMARCHY_TOKEN");
+    vmID      = envOr("WOMARCHY_VM_ID");
+    shmDir    = envOr("WOMARCHY_SHM_DIR");
+    unixPath  = envOr("WOMARCHY_LISTEN_UNIX");
+    vsockPort = (uint32_t)std::stoul(envOr("WOMARCHY_VSOCK_PORT", "0"));
+    orphanTimeoutS = (uint32_t)std::stoul(envOr("WOMARCHY_ORPHAN_TIMEOUT", "0"));
+
+    if (token.size() != WDP_TOKEN_BYTES * 2 || !std::ranges::all_of(token, [](char c) { return std::isxdigit((unsigned char)c); })) {
+        backend->log(AQ_LOG_ERROR, "wsl: WOMARCHY_TOKEN must be 64 hex characters");
+        return false;
+    }
+
+    initialMonitors = parseMonitorsEnv(getenv("WOMARCHY_MONITORS"));
+    if (initialMonitors.empty())
+        initialMonitors.push_back(SMonitorSpec{.id = 1, .name = "default"});
+
+    allocator = CShmAllocator::create(backend.lock(), shmDir, "womarchy");
+
+    timerFD   = Hyprutils::OS::CFileDescriptor{timerfd_create(CLOCK_MONOTONIC, TFD_CLOEXEC | TFD_NONBLOCK)};
+    ackPollFD = Hyprutils::OS::CFileDescriptor{timerfd_create(CLOCK_MONOTONIC, TFD_CLOEXEC | TFD_NONBLOCK)};
+    if (!timerFD.isValid() || !ackPollFD.isValid()) {
+        backend->log(AQ_LOG_ERROR, std::format("wsl: timerfd failed: {}", strerror(errno)));
+        return false;
+    }
+
+    if (!listenSocket())
+        return false;
+
+    armOrphanTimer();
+    return true;
+}
+
+void Aquamarine::CWslBackend::armOrphanTimer() {
+    const uint64_t GEN = ++orphanGeneration;
+    if (!orphanTimeoutS)
+        return;
+
+    auto check = makeShared<std::function<void()>>([this, weak = self, GEN]() {
+        if (!weak || GEN != orphanGeneration || authenticated)
+            return;
+        backend->log(AQ_LOG_ERROR, std::format("wsl: no viewer for {} s, ending the session", orphanTimeoutS));
+        kill(getpid(), SIGTERM);
+    });
+    addTimer(std::chrono::steady_clock::now() + std::chrono::seconds(orphanTimeoutS), check);
+}
+
+bool Aquamarine::CWslBackend::listenSocket() {
+    int fd = -1;
+    if (!unixPath.empty()) {
+        fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
+        sockaddr_un addr{.sun_family = AF_UNIX};
+        strncpy(addr.sun_path, unixPath.c_str(), sizeof(addr.sun_path) - 1);
+        unlink(unixPath.c_str());
+        if (fd < 0 || bind(fd, (sockaddr*)&addr, sizeof(addr)) != 0) {
+            backend->log(AQ_LOG_ERROR, std::format("wsl: cannot bind unix socket {}: {}", unixPath, strerror(errno)));
+            return false;
+        }
+    } else if (vsockPort) {
+        fd = socket(AF_VSOCK, SOCK_STREAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
+        sockaddr_vm addr{.svm_family = AF_VSOCK, .svm_port = vsockPort, .svm_cid = VMADDR_CID_ANY};
+        if (fd < 0 || bind(fd, (sockaddr*)&addr, sizeof(addr)) != 0) {
+            backend->log(AQ_LOG_ERROR, std::format("wsl: cannot bind vsock port {}: {}", vsockPort, strerror(errno)));
+            return false;
+        }
+    } else {
+        backend->log(AQ_LOG_ERROR, "wsl: set WOMARCHY_VSOCK_PORT (or WOMARCHY_LISTEN_UNIX for testing)");
+        return false;
+    }
+
+    if (listen(fd, 2) != 0) {
+        backend->log(AQ_LOG_ERROR, std::format("wsl: listen failed: {}", strerror(errno)));
+        close(fd);
+        return false;
+    }
+
+    listenFD = Hyprutils::OS::CFileDescriptor{fd};
+    backend->log(AQ_LOG_DEBUG, std::format("wsl: waiting for the viewer on {}", unixPath.empty() ? std::format("vsock port {}", vsockPort) : unixPath));
+    return true;
+}
+
+std::vector<SP<SPollFD>> Aquamarine::CWslBackend::pollFDs() {
+    // Hand the compositor's event loop the real fds (it re-queries on pollFDsChanged).
+    // A nested epoll fd did not reliably wake the loop for vsock readiness.
+    std::vector<SP<SPollFD>> fds;
+    fds.push_back(makeShared<SPollFD>(listenFD.get(), [this]() { acceptClient(); }));
+    fds.push_back(makeShared<SPollFD>(timerFD.get(), [this]() { dispatchTimers(); }));
+    fds.push_back(makeShared<SPollFD>(ackPollFD.get(), [this]() { onAckPoll(); }));
+    if (clientFD.isValid())
+        fds.push_back(makeShared<SPollFD>(clientFD.get(), [this]() { readClient(); }));
+    return fds;
+}
+
+bool Aquamarine::CWslBackend::connected() const {
+    return clientFD.isValid() && authenticated;
+}
+
+void Aquamarine::CWslBackend::acceptClient() {
+    int fd = accept4(listenFD.get(), nullptr, nullptr, SOCK_CLOEXEC | SOCK_NONBLOCK);
+    if (fd < 0)
+        return;
+
+    if (clientFD.isValid()) {
+        // a new viewer replaces the old one (e.g. the viewer restarted)
+        dropClient("replaced by a new viewer connection");
+    }
+
+    int bufSize = 8 << 20;
+    setsockopt(fd, SOL_SOCKET, SO_SNDBUF, &bufSize, sizeof(bufSize));
+
+    clientFD      = Hyprutils::OS::CFileDescriptor{fd};
+    authenticated = false;
+    rxBuffer.clear();
+    backend->events.pollFDsChanged.emit();
+    backend->log(AQ_LOG_DEBUG, "wsl: viewer connected, awaiting hello");
+}
+
+void Aquamarine::CWslBackend::dropClient(const std::string& why) {
+    if (!clientFD.isValid())
+        return;
+
+    backend->log(AQ_LOG_DEBUG, std::format("wsl: viewer disconnected ({})", why));
+    // Keep the fd open until the event loop has dropped its source for it: we may be running
+    // inside that source's callback right now.
+    auto closing = makeShared<Hyprutils::OS::CFileDescriptor>(std::move(clientFD));
+    clientFD.reset();
+    auto refresh = makeShared<std::function<void()>>();
+    *refresh     = [this, weak = self, closing]() mutable {
+        if (!weak)
+            return;
+        backend->events.pollFDsChanged.emit();
+        closing.reset();
+    };
+    backend->addIdleEvent(refresh);
+    authenticated = false;
+    rxBuffer.clear();
+    armOrphanTimer();
+    releaseAllInput();
+
+    for (auto const& o : outputs) {
+        o->frameInFlight = false;
+        if (o->needsFrame && !o->frameScheduled)
+            o->queueFrame();
+    }
+    updateAckPoll();
+}
+
+void Aquamarine::CWslBackend::readClient() {
+    uint8_t chunk[65536];
+    while (true) {
+        const ssize_t n = read(clientFD.get(), chunk, sizeof(chunk));
+        if (n == 0) {
+            dropClient("eof");
+            return;
+        }
+        if (n < 0) {
+            if (errno == EAGAIN || errno == EINTR)
+                break;
+            dropClient(strerror(errno));
+            return;
+        }
+        rxBuffer.insert(rxBuffer.end(), chunk, chunk + n);
+    }
+
+    size_t off = 0;
+    while (rxBuffer.size() - off >= sizeof(wdp_header)) {
+        wdp_header hdr;
+        memcpy(&hdr, rxBuffer.data() + off, sizeof(hdr));
+        if (hdr.size > (64u << 20)) {
+            dropClient("oversized message");
+            return;
+        }
+        if (rxBuffer.size() - off - sizeof(hdr) < hdr.size)
+            break;
+        handleMessage(hdr.type, rxBuffer.data() + off + sizeof(hdr), hdr.size);
+        if (!clientFD.isValid())
+            return; // dropped while handling
+        off += sizeof(hdr) + hdr.size;
+    }
+    rxBuffer.erase(rxBuffer.begin(), rxBuffer.begin() + off);
+}
+
+// hv_sock does not always wake a non-blocking reader when the host writes (observed on WSL 3.0.1:
+// every other ack sat unread for ~200 ms until unrelated VMBus traffic arrived). While a frame is
+// in flight, also poll the socket every millisecond; nothing runs when idle.
+void Aquamarine::CWslBackend::updateAckPoll() {
+    const bool ANYINFLIGHT = connected() && std::ranges::any_of(outputs, [](const auto& o) { return o->frameInFlight; });
+    if (ANYINFLIGHT == ackPollArmed)
+        return;
+    ackPollArmed = ANYINFLIGHT;
+    itimerspec ts{};
+    if (ANYINFLIGHT)
+        ts = {.it_interval = {.tv_sec = 0, .tv_nsec = 1000000}, .it_value = {.tv_sec = 0, .tv_nsec = 1000000}};
+    timerfd_settime(ackPollFD.get(), 0, &ts, nullptr);
+}
+
+void Aquamarine::CWslBackend::onAckPoll() {
+    uint64_t expirations = 0;
+    (void)!read(ackPollFD.get(), &expirations, sizeof(expirations));
+    if (clientFD.isValid())
+        readClient();
+    updateAckPoll();
+}
+
+template <typename T>
+static bool readStruct(T& out, const uint8_t* data, uint32_t size) {
+    if (size < sizeof(T))
+        return false;
+    memcpy(&out, data, sizeof(T));
+    return true;
+}
+
+void Aquamarine::CWslBackend::handleMessage(uint32_t type, const uint8_t* data, uint32_t size) {
+    if (!authenticated) {
+        wdp_hello hello{};
+        const auto expected = hexToBytes(token);
+        if (type != WDP_HELLO || !readStruct(hello, data, size) || hello.version != WDP_VERSION || expected.size() != WDP_TOKEN_BYTES ||
+            memcmp(hello.token, expected.data(), WDP_TOKEN_BYTES) != 0) {
+            dropClient("bad hello");
+            return;
+        }
+
+        authenticated        = true;
+        orphanGeneration++;
+        const bool CANSECTION = !shmDir.empty() && (hello.transports & (1u << WDP_TRANSPORT_SECTION));
+        transport             = CANSECTION ? WDP_TRANSPORT_SECTION : WDP_TRANSPORT_INLINE;
+
+        wdp_welcome welcome{.version = WDP_VERSION, .transport = transport};
+        strncpy(welcome.vm_id, vmID.c_str(), sizeof(welcome.vm_id) - 1);
+        send(WDP_WELCOME, &welcome, sizeof(welcome));
+        backend->log(AQ_LOG_DEBUG, std::format("wsl: viewer authenticated, transport {}", transport == WDP_TRANSPORT_SECTION ? "section (shared memory)" : "inline"));
+
+        for (auto const& o : outputs) {
+            o->announcedSize = {};
+            o->scheduleFrame(IOutput::AQ_SCHEDULE_NEW_MONITOR);
+        }
+        if (cursor.buffer || !cursor.visible)
+            sendCursor(cursor.visible, cursor.buffer, cursor.hotspot);
+        return;
+    }
+
+    switch (type) {
+        case WDP_MONITORS: {
+            wdp_monitors hdr{};
+            if (!readStruct(hdr, data, size) || size < sizeof(hdr) + (size_t)hdr.count * sizeof(wdp_monitor))
+                break;
+            std::vector<SMonitorSpec> specs;
+            for (uint32_t i = 0; i < hdr.count; ++i) {
+                wdp_monitor m{};
+                memcpy(&m, data + sizeof(hdr) + (size_t)i * sizeof(wdp_monitor), sizeof(m));
+                specs.push_back(SMonitorSpec{.id         = m.id,
+                                             .x          = m.x,
+                                             .y          = m.y,
+                                             .width      = m.width,
+                                             .height     = m.height,
+                                             .refreshmHz = m.refresh_mhz,
+                                             .scale1000  = m.scale_1000,
+                                             .primary    = !!m.primary,
+                                             .name       = std::string{m.name, strnlen(m.name, sizeof(m.name))}});
+            }
+            applyMonitors(specs);
+            break;
+        }
+        case WDP_FRAME_DONE: {
+            wdp_frame_done done{};
+            if (!readStruct(done, data, size))
+                break;
+            if (auto o = outputByID(done.output_id))
+                o->onFrameDone(done.seq);
+            break;
+        }
+        case WDP_KEY: {
+            wdp_key k{};
+            if (!readStruct(k, data, size) || !keyboard)
+                break;
+            if (k.pressed)
+                pressedKeys.insert(k.key);
+            else if (!pressedKeys.erase(k.key))
+                break; // release for a key we never saw pressed
+            keyboard->events.key.emit(IKeyboard::SKeyEvent{.timeMs = nowMs(), .key = k.key, .pressed = !!k.pressed});
+            break;
+        }
+        case WDP_POINTER_ABS: {
+            wdp_pointer_abs p{};
+            if (!readStruct(p, data, size) || !pointer)
+                break;
+            auto o = outputByID(p.output_id);
+            if (!o || o->announcedSize.x <= 0 || o->announcedSize.y <= 0)
+                break;
+            pointer->events.warp.emit(IPointer::SWarpEvent{
+                .timeMs   = nowMs(),
+                .absolute = Vector2D{p.x / o->announcedSize.x, p.y / o->announcedSize.y},
+                .output   = SP<IOutput>(o),
+            });
+            break;
+        }
+        case WDP_POINTER_REL: {
+            wdp_pointer_rel p{};
+            if (!readStruct(p, data, size) || !pointer)
+                break;
+            pointer->events.move.emit(IPointer::SMoveEvent{.timeMs = nowMs(), .delta = {p.dx, p.dy}, .unaccel = {p.dx, p.dy}});
+            break;
+        }
+        case WDP_POINTER_BUTTON: {
+            wdp_pointer_button b{};
+            if (!readStruct(b, data, size) || !pointer)
+                break;
+            if (b.pressed)
+                pressedButtons.insert(b.button);
+            else if (!pressedButtons.erase(b.button))
+                break;
+            pointer->events.button.emit(IPointer::SButtonEvent{.timeMs = nowMs(), .button = b.button, .pressed = !!b.pressed});
+            break;
+        }
+        case WDP_POINTER_AXIS: {
+            wdp_pointer_axis a{};
+            if (!readStruct(a, data, size) || !pointer)
+                break;
+            pointer->events.axis.emit(IPointer::SAxisEvent{
+                .timeMs   = nowMs(),
+                .axis     = a.axis == 1 ? IPointer::AQ_POINTER_AXIS_HORIZONTAL : IPointer::AQ_POINTER_AXIS_VERTICAL,
+                .source   = a.discrete120 ? IPointer::AQ_POINTER_AXIS_SOURCE_WHEEL : IPointer::AQ_POINTER_AXIS_SOURCE_CONTINUOUS,
+                .delta    = a.delta,
+                .discrete = (double)a.discrete120,
+            });
+            break;
+        }
+        case WDP_POINTER_FRAME:
+            if (pointer)
+                pointer->events.frame.emit();
+            break;
+        case WDP_FOCUS: {
+            wdp_focus f{};
+            if (readStruct(f, data, size) && !f.focused)
+                releaseAllInput();
+            break;
+        }
+        case WDP_QUIT:
+            backend->log(AQ_LOG_DEBUG, "wsl: viewer requested the session to end");
+            kill(getpid(), SIGTERM);
+            break;
+        default: break;
+    }
+}
+
+void Aquamarine::CWslBackend::releaseAllInput() {
+    for (auto const& k : pressedKeys) {
+        if (keyboard)
+            keyboard->events.key.emit(IKeyboard::SKeyEvent{.timeMs = nowMs(), .key = k, .pressed = false});
+    }
+    pressedKeys.clear();
+    for (auto const& b : pressedButtons) {
+        if (pointer)
+            pointer->events.button.emit(IPointer::SButtonEvent{.timeMs = nowMs(), .button = b, .pressed = false});
+    }
+    if (!pressedButtons.empty() && pointer)
+        pointer->events.frame.emit();
+    pressedButtons.clear();
+}
+
+uint32_t Aquamarine::CWslBackend::nowMs() const {
+    timespec ts{};
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint32_t)(ts.tv_sec * 1000 + ts.tv_nsec / 1000000);
+}
+
+bool Aquamarine::CWslBackend::writeAll(const uint8_t* data, size_t size) {
+    while (size > 0) {
+        const ssize_t n = ::send(clientFD.get(), data, size, MSG_NOSIGNAL);
+        if (n > 0) {
+            data += n;
+            size -= n;
+            continue;
+        }
+        if (n < 0 && (errno == EAGAIN || errno == EINTR)) {
+            pollfd pfd{.fd = clientFD.get(), .events = POLLOUT};
+            if (poll(&pfd, 1, WRITE_TIMEOUT_MS) <= 0)
+                return false;
+            continue;
+        }
+        return false;
+    }
+    return true;
+}
+
+bool Aquamarine::CWslBackend::send(uint32_t type, const void* payload, size_t size, const void* extra, size_t extraSize) {
+    if (!clientFD.isValid())
+        return false;
+
+    // One write per message: hv_sock only signals the host when the ring goes from empty to
+    // non-empty, so splitting a message into several small writes can leave the tail waiting for
+    // a later signal (observed: ~180 ms stalls on every other frame).
+    wdp_header hdr{.type = type, .size = (uint32_t)(size + extraSize)};
+    txBuffer.resize(sizeof(hdr) + size + extraSize);
+    memcpy(txBuffer.data(), &hdr, sizeof(hdr));
+    if (size)
+        memcpy(txBuffer.data() + sizeof(hdr), payload, size);
+    if (extraSize)
+        memcpy(txBuffer.data() + sizeof(hdr) + size, extra, extraSize);
+
+    if (!writeAll(txBuffer.data(), txBuffer.size())) {
+        dropClient("write failed");
+        return false;
+    }
+    return true;
+}
+
+SP<CWslOutput> Aquamarine::CWslBackend::outputByID(uint32_t id) {
+    for (auto const& o : outputs) {
+        if (o->monitorID == id)
+            return o;
+    }
+    return nullptr;
+}
+
+void Aquamarine::CWslBackend::announceOutput(SP<CWslOutput> output) {
+    const auto  MODE = output->state->state().mode ? output->state->state().mode : (output->modes.empty() ? nullptr : output->modes.front());
+    wdp_output  msg{.output_id = output->monitorID, .refresh_mhz = MODE ? MODE->refreshRate : 60000};
+    msg.width  = (uint32_t)output->announcedSize.x;
+    msg.height = (uint32_t)output->announcedSize.y;
+    strncpy(msg.name, output->name.c_str(), sizeof(msg.name) - 1);
+    send(WDP_OUTPUT, &msg, sizeof(msg));
+}
+
+bool Aquamarine::CWslBackend::sendFrame(SP<CWslOutput> output, SP<IBuffer> buffer, const CRegion& damage) {
+    auto* shm = dynamic_cast<CShmBuffer*>(buffer.get());
+    if (!shm || !shm->good())
+        return false;
+
+    const Vector2D SIZE     = buffer->size;
+    bool           fullDamage = false;
+    if (output->announcedSize != SIZE) {
+        output->announcedSize = SIZE;
+        announceOutput(output);
+        fullDamage = true; // new viewer texture
+    }
+
+    CRegion region = fullDamage ? CRegion{0, 0, SIZE.x, SIZE.y} : damage.copy().intersect(CBox{{0, 0}, SIZE});
+    if (region.empty())
+        region = CRegion{0, 0, SIZE.x, SIZE.y};
+
+    std::vector<wdp_rect> rects;
+    if (region.getRects().size() > MAX_FRAME_RECTS) {
+        const auto EXT = region.getExtents();
+        rects.push_back(wdp_rect{(int32_t)EXT.x, (int32_t)EXT.y, (int32_t)EXT.w, (int32_t)EXT.h});
+    } else {
+        region.forEachRect([&](const auto& r) {
+            if (r.x2 > r.x1 && r.y2 > r.y1)
+                rects.push_back(wdp_rect{r.x1, r.y1, r.x2 - r.x1, r.y2 - r.y1});
+        });
+    }
+
+    wdp_frame frame{
+        .output_id = output->monitorID,
+        .width     = (uint32_t)SIZE.x,
+        .height    = (uint32_t)SIZE.y,
+        .stride    = shm->stride(),
+        .format    = shm->format(),
+        .seq       = ++output->seq,
+        .nrects    = (uint32_t)rects.size(),
+    };
+    strncpy(frame.buffer, shm->fileName().c_str(), sizeof(frame.buffer) - 1);
+
+    std::vector<uint8_t> payload(sizeof(frame) + rects.size() * sizeof(wdp_rect));
+    memcpy(payload.data(), &frame, sizeof(frame));
+    memcpy(payload.data() + sizeof(frame), rects.data(), rects.size() * sizeof(wdp_rect));
+
+    if (wslTrace())
+        backend->log(AQ_LOG_DEBUG, std::format("wsl-trace {:.2f} {} send seq {} rects {}", nowMsF(), output->name, frame.seq, rects.size()));
+
+    if (transport == WDP_TRANSPORT_SECTION)
+        return send(WDP_FRAME, payload.data(), payload.size());
+
+    // inline: pack the pixels of every rect after the rect list
+    size_t pixelBytes = 0;
+    for (auto const& r : rects)
+        pixelBytes += (size_t)r.w * r.h * 4;
+    std::vector<uint8_t> pixels(pixelBytes);
+    uint8_t*             dst = pixels.data();
+    for (auto const& r : rects) {
+        for (int32_t y = 0; y < r.h; ++y) {
+            memcpy(dst, shm->data() + (size_t)(r.y + y) * shm->stride() + (size_t)r.x * 4, (size_t)r.w * 4);
+            dst += (size_t)r.w * 4;
+        }
+    }
+    return send(WDP_FRAME, payload.data(), payload.size(), pixels.data(), pixels.size());
+}
+
+void Aquamarine::CWslBackend::sendCursor(bool visible, SP<IBuffer> buffer, const Vector2D& hotspot) {
+    if (!connected())
+        return;
+
+    wdp_cursor msg{.visible = visible};
+    if (!buffer) {
+        send(WDP_CURSOR, &msg, sizeof(msg));
+        return;
+    }
+
+    auto [data, fmt, len] = buffer->beginDataPtr(0);
+    if (!data) {
+        send(WDP_CURSOR, &msg, sizeof(msg));
+        return;
+    }
+
+    msg.has_image          = 1;
+    msg.width              = (uint32_t)buffer->size.x;
+    msg.height             = (uint32_t)buffer->size.y;
+    msg.hot_x              = (int32_t)hotspot.x;
+    msg.hot_y              = (int32_t)hotspot.y;
+    const size_t IMGBYTES = (size_t)msg.width * msg.height * 4;
+    send(WDP_CURSOR, &msg, sizeof(msg), data, std::min(IMGBYTES, len));
+    buffer->endDataPtr();
+}
+
+void Aquamarine::CWslBackend::applyMonitors(const std::vector<SMonitorSpec>& monitors) {
+    // remove outputs whose monitor vanished
+    std::vector<SP<CWslOutput>> gone;
+    for (auto const& o : outputs) {
+        if (std::ranges::none_of(monitors, [&](const auto& m) { return m.id == o->monitorID; }))
+            gone.push_back(o);
+    }
+    for (auto const& o : gone) {
+        wdp_output_removed msg{.output_id = o->monitorID};
+        send(WDP_OUTPUT_REMOVED, &msg, sizeof(msg));
+        o->destroy();
+    }
+
+    for (auto const& m : monitors) {
+        const Vector2D SIZE{(double)m.width, (double)m.height};
+        if (auto existing = outputByID(m.id)) {
+            if (existing->modes.empty() || existing->modes.front()->pixelSize != SIZE || existing->modes.front()->refreshRate != m.refreshmHz) {
+                existing->updateMode(SIZE, m.refreshmHz);
+                backend->log(AQ_LOG_DEBUG, std::format("wsl: output {} is now {}x{}@{}mHz", existing->name, m.width, m.height, m.refreshmHz));
+                // Hyprland treats non-DRM outputs like user-created ones: a sized state event makes it
+                // re-apply the monitor rule at that resolution
+                existing->events.state.emit(IOutput::SStateEvent{.size = SIZE});
+            }
+            continue;
+        }
+
+        auto output = SP<CWslOutput>(new CWslOutput(std::format("WSL-{}", m.id), m.id, self));
+        output->self = output;
+        output->updateMode(SIZE, m.refreshmHz);
+        output->physicalSize = SIZE / (96.0 * m.scale1000 / 1000.0) * 25.4; // mm at the Windows DPI
+        output->swapchain    = CSwapchain::create(allocator, self.lock());
+        outputs.emplace_back(output);
+        backend->log(AQ_LOG_DEBUG, std::format("wsl: new output {} ({}x{}@{}mHz, scale {})", output->name, m.width, m.height, m.refreshmHz, m.scale1000 / 1000.0));
+        backend->events.newOutput.emit(SP<IOutput>(output));
+        output->scheduleFrame(IOutput::AQ_SCHEDULE_NEW_MONITOR);
+    }
+}
+
+void Aquamarine::CWslBackend::addTimer(std::chrono::steady_clock::time_point when, SP<std::function<void()>> what) {
+    timers.push_back(STimer{.when = when, .what = what});
+
+    auto soonest = timers.front().when;
+    for (auto const& t : timers)
+        soonest = std::min(soonest, t.when);
+
+    const auto NS = std::chrono::duration_cast<std::chrono::nanoseconds>(soonest.time_since_epoch()).count();
+    itimerspec ts{.it_value = {.tv_sec = NS / 1000000000LL, .tv_nsec = NS % 1000000000LL}};
+    if (ts.it_value.tv_sec == 0 && ts.it_value.tv_nsec == 0)
+        ts.it_value.tv_nsec = 1;
+    const int rc = timerfd_settime(timerFD.get(), TFD_TIMER_ABSTIME, &ts, nullptr);
+    if (wslTrace())
+        backend->log(AQ_LOG_DEBUG,
+                     std::format("wsl-trace {:.2f} addTimer in {:.2f} ms (pending {}) rc {}", nowMsF(),
+                                 std::chrono::duration<double, std::milli>(soonest - std::chrono::steady_clock::now()).count(), timers.size(), rc));
+}
+
+void Aquamarine::CWslBackend::dispatchTimers() {
+    uint64_t expirations = 0;
+    (void)!read(timerFD.get(), &expirations, sizeof(expirations));
+
+    const auto          NOW = std::chrono::steady_clock::now();
+    if (wslTrace())
+        backend->log(AQ_LOG_DEBUG, std::format("wsl-trace {:.2f} dispatchTimers expirations {} pending {}", nowMsF(), expirations, timers.size()));
+    std::vector<STimer> due;
+    std::erase_if(timers, [&](const auto& t) {
+        if (t.when > NOW)
+            return false;
+        due.push_back(t);
+        return true;
+    });
+
+    for (auto const& t : due) {
+        if (t.what && *t.what)
+            (*t.what)();
+    }
+
+    if (!timers.empty()) {
+        auto next = timers.back();
+        timers.pop_back();
+        addTimer(next.when, next.what);
+    }
+}
