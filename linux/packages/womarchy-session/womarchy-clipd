#!/usr/bin/env python3
"""womarchy-clipd: shares the session's Wayland clipboard with Windows through omarchy.exe (text and
images).

Listens on vsock port WOMARCHY_VSOCK_PORT + 1 for omarchy.exe. The session token WOMARCHY_CLIP_TOKEN
(64 hex chars) authenticates both ends: the viewer sends its first half (CLIP_HELLO), we answer with the
second half (CLIP_WELCOME); then both sides send CLIP_TEXT (UTF-8, LF line endings), or CLIP_IMAGE (a
PNG) when the clipboard holds an image and no text, whenever their clipboard changes. See
protocol/wdp.h. The Wayland side uses wl-clipboard (data-control, so no focus is needed). Clipboard
entries marked as passwords (x-kde-passwordManagerHint) never leave Linux.
Runs as the user service womarchy-clipd.service inside the graphical session.
"""
import hmac
import os
import select
import socket
import struct
import subprocess
import sys
import time

VERSION = 2
CLIP_HELLO, CLIP_TEXT, CLIP_WELCOME, CLIP_IMAGE = 200, 201, 202, 203
CLIP_PORT_OFFSET = 1
PROOF_BYTES = 16
MAX_TEXT = 16 << 20
MAX_IMAGE = 32 << 20  # PNG bytes
HELLO_TIMEOUT = 5.0
PNG_SIGNATURE = b"\x89PNG\r\n\x1a\n"
HEADER = struct.Struct("<II")
HELLO = struct.Struct(f"<I{PROOF_BYTES}s")
PASSWORD_HINT = "x-kde-passwordManagerHint"


def log(*args):
    print("womarchy-clipd:", *args, file=sys.stderr, flush=True)


def recv_exact(sock, n, deadline=None):
    buf = bytearray()
    while len(buf) < n:
        if deadline is not None:
            left = deadline - time.monotonic()
            if left <= 0:
                raise ConnectionError("timed out")
            sock.settimeout(left)
        chunk = sock.recv(n - len(buf))
        if not chunk:
            raise ConnectionError("closed")
        buf += chunk
    return bytes(buf)


def recv_msg(sock):
    mtype, size = HEADER.unpack(recv_exact(sock, HEADER.size))
    if size > MAX_IMAGE:
        raise ConnectionError(f"oversized message ({size} bytes)")
    return mtype, recv_exact(sock, size)


def send_msg(sock, mtype, payload):
    sock.sendall(HEADER.pack(mtype, len(payload)) + payload)


def authenticate(conn, token):
    """Read exactly one CLIP_HELLO within HELLO_TIMEOUT, check its proof, answer with ours."""
    deadline = time.monotonic() + HELLO_TIMEOUT
    mtype, size = HEADER.unpack(recv_exact(conn, HEADER.size, deadline))
    if mtype != CLIP_HELLO or not HELLO.size <= size <= 256:
        return False
    version, proof = HELLO.unpack_from(recv_exact(conn, size, deadline))
    if version != VERSION or not hmac.compare_digest(proof, token[:PROOF_BYTES]):
        return False
    conn.settimeout(None)
    send_msg(conn, CLIP_WELCOME, HELLO.pack(VERSION, token[PROOF_BYTES:]))
    return True


def run(cmd, data=None, capture=True):
    """Run a wl-clipboard command; None if it failed or hung (an app holding the selection can freeze)."""
    out = subprocess.PIPE if capture else subprocess.DEVNULL
    try:
        return subprocess.run(cmd, input=data, stdout=out, stderr=out, timeout=5)
    except (OSError, subprocess.TimeoutExpired) as e:
        log(f"{cmd[0]}: {e}")
        return None


def wayland_clip():
    """The clipboard as (CLIP_TEXT, utf-8 bytes) or (CLIP_IMAGE, png bytes): text when there is any (as most
    programs expect), else a PNG image. None when empty, too big, or a password the user's password
    manager marked."""
    types = run(["wl-paste", "--list-types"])
    if types is None or types.returncode != 0:
        return None
    offered = types.stdout.decode("utf-8", "replace").split()
    if PASSWORD_HINT in offered:
        return None
    if any(t.startswith("text/plain") or t in ("UTF8_STRING", "TEXT", "STRING") for t in offered):
        r = run(["wl-paste", "--no-newline", "--type", "text"])
        if r is not None and r.returncode == 0 and len(r.stdout) <= MAX_TEXT:
            return CLIP_TEXT, r.stdout.decode("utf-8", "replace").encode("utf-8")
    elif "image/png" in offered:
        r = run(["wl-paste", "--type", "image/png"])
        if r is not None and r.returncode == 0 and r.stdout.startswith(PNG_SIGNATURE) and len(r.stdout) <= MAX_IMAGE:
            return CLIP_IMAGE, r.stdout
    return None


def set_wayland_clip(kind, data):
    # wl-copy forks a server that owns the selection until something else is copied; that server keeps
    # any output pipes open, so capturing its output would wait for it (the timeout) on every copy
    mime = "text/plain;charset=utf-8" if kind == CLIP_TEXT else "image/png"
    run(["wl-copy", "--type", mime], data, capture=False)


def main():
    try:
        token = bytes.fromhex(os.environ.get("WOMARCHY_CLIP_TOKEN", ""))
        port = int(os.environ["WOMARCHY_VSOCK_PORT"]) + CLIP_PORT_OFFSET
    except (KeyError, ValueError):
        log("WOMARCHY_CLIP_TOKEN/WOMARCHY_VSOCK_PORT missing or invalid")
        return 1
    if len(token) != 2 * PROOF_BYTES:
        log("WOMARCHY_CLIP_TOKEN must be 64 hex characters")
        return 1

    server = socket.socket(socket.AF_VSOCK, socket.SOCK_STREAM)
    try:
        server.bind((socket.VMADDR_CID_ANY, port))
    except OSError as e:
        log(f"cannot listen on vsock port {port}: {e}")
        return 1
    server.listen(1)
    # one line per clipboard change (the command's output); the text itself is fetched with wl-paste
    watch = subprocess.Popen(["wl-paste", "--watch", "echo"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    log(f"listening on vsock port {port}")

    client = None
    last = None  # last (kind, bytes) synced in either direction
    while True:
        fds = [server, watch.stdout] + ([client] if client else [])
        ready, _, _ = select.select(fds, [], [])

        if watch.stdout in ready:
            if not watch.stdout.readline():
                log("the compositor went away; exiting")  # the session is ending: a normal stop
                return 0
            clip = wayland_clip()
            if clip is not None and clip != last:
                last = clip
                if client:
                    try:
                        send_msg(client, *clip)
                    except OSError:
                        client.close()
                        client = None

        if server in ready:
            conn, _ = server.accept()
            try:
                ok = authenticate(conn, token)
            except (OSError, ConnectionError, struct.error):
                ok = False
            if not ok:
                conn.close()
                continue
            if client:
                client.close()
            client = conn
            last = None  # the viewer sends Windows' clipboard first; take it
            log("viewer connected")

        if client and client in ready:
            try:
                mtype, payload = recv_msg(client)
            except (OSError, ConnectionError):
                client.close()
                client = None
                log("viewer disconnected")
                continue
            if mtype == CLIP_TEXT and len(payload) <= MAX_TEXT:
                clip = (CLIP_TEXT, payload.decode("utf-8", "replace").encode("utf-8"))
            elif mtype == CLIP_IMAGE and payload.startswith(PNG_SIGNATURE):
                clip = (CLIP_IMAGE, payload)
            else:
                continue
            if clip != last:
                last = clip
                set_wayland_clip(*clip)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        pass
