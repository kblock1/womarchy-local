#!/usr/bin/env bash
# womarchy-session: what omarchy.exe runs inside the distro (`wsl.exe -d <distro> --exec womarchy-session`).
#
# 1. prints the handshake line "WOMARCHY_VMID=<guid>" on stdout (omarchy.exe connects to that VM over hvsocket)
# 2. prepares the session: shared-memory share, per-launch monitor rules from the Windows layout, clean PATH
# 3. starts Omarchy's session the way its display manager would (uwsm → Hyprland) with Hyprland's wsl
#    backend selected, waits for it to end, and exits with the compositor's status
#
# In (from omarchy.exe via WSLENV): WOMARCHY_TOKEN, WOMARCHY_CLIP_TOKEN, WOMARCHY_VSOCK_PORT, WOMARCHY_MONITORS
# Optional: WOMARCHY_TRACE=1 (backend frame trace), WOMARCHY_NO_UWSM=1 (run start-hyprland directly)
# `womarchy-session --update-monitors`: omarchy.exe, when the Windows display layout changes mid-session
# Logs: ~/.cache/womarchy/session.log (this script and uwsm), hyprland.log (the last compositor log)
set -u

LOG_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/womarchy

# Monitor rules from the Windows layout (WOMARCHY_MONITORS: "id:x:y:w:h:mHz:scale1000:primary:name;...").
# Windows positions are physical pixels; Hyprland's are logical (pixels / scale). Outputs are placed in
# left-to-right order: each one starts where the outputs that end left of it end (in logical pixels,
# using their already resolved positions), likewise top to bottom, so mixed-DPI layouts have neither
# gaps nor overlaps. Scales are the ones Hyprland will accept (see clean_scale).
write_monitor_rules() { # <file>
  awk -v spec="${WOMARCHY_MONITORS:-}" '
  BEGIN {
    n = split(spec, mons, ";"); k = 0; maxs = 1
    for (i = 1; i <= n; i++) {
      if (split(mons[i], f, ":") < 7 || f[4] <= 0 || f[5] <= 0) continue
      k++; id[k] = f[1]; x[k] = f[2] + 0; y[k] = f[3] + 0; w[k] = f[4] + 0; h[k] = f[5] + 0
      s[k] = f[7] / 1000; if (s[k] < 1) s[k] = 1
      s[k] = clean_scale(w[k], h[k], s[k])
      if (s[k] > maxs) maxs = s[k]
      if (k == 1 || x[k] < minx) minx = x[k]
      if (k == 1 || y[k] < miny) miny = y[k]
    }
    place(x, w, minx, lx)
    place(y, h, miny, ly)
    print "-- generated by womarchy-session from the Windows display layout; do not edit"
    print "hl.monitor({ output = \"\", mode = \"preferred\", position = \"auto\", scale = \"auto\" })"
    for (i = 1; i <= k; i++)
      printf "hl.monitor({ output = \"WSL-%s\", mode = \"preferred\", position = \"%dx%d\", scale = \"%.6g\" })\n", id[i], lx[i], ly[i], s[i]
    # XWayland apps: Omarchy renders them unscaled and lets GDK scale; 2 on HiDPI desktops, 1 otherwise
    printf "hl.env(\"GDK_SCALE\", \"%d\")\n", (maxs >= 1.5 ? 2 : 1)
  }
  # One axis: pos/len are physical, out[] gets logical positions. Visit outputs in physical order; an
  # output starts at the farthest logical end of the outputs that end before it physically starts, or,
  # with none (e.g. stacked on the other axis), at its own physical offset scaled.
  function place(pos, len, min, out,   order, i, j, t, a, b, e) {
    for (i = 1; i <= k; i++) order[i] = i
    for (i = 2; i <= k; i++)                      # insertion sort by physical position
      for (j = i; j > 1 && pos[order[j - 1]] > pos[order[j]]; j--) { t = order[j]; order[j] = order[j - 1]; order[j - 1] = t }
    for (i = 1; i <= k; i++) {
      a = order[i]; out[a] = -1
      for (j = 1; j < i; j++) {
        b = order[j]
        if (pos[b] + len[b] <= pos[a]) { e = out[b] + len[b] / s[b]; if (e > out[a]) out[a] = e }
      }
      if (out[a] < 0) out[a] = (pos[a] - min) / s[a]
      out[a] = int(out[a] + 0.5)
    }
  }
  # Hyprland only accepts scales that give whole logical pixels; it otherwise searches 1/120 steps
  # outward for one (and shows a notification). Pick the same one here, so the rule is taken as is
  # and the positions use the scale Hyprland will really apply (e.g. 175% of 3840x2160 -> 5/3).
  function clean_scale(w, h, sc,   base, i) {
    base = int(sc * 120 + 0.5)
    if (divides(w, h, base)) return base / 120
    for (i = 1; i < 90; i++) {
      if (divides(w, h, base + i)) return (base + i) / 120
      if (base - i > 0 && divides(w, h, base - i)) return (base - i) / 120
    }
    return sc
  }
  function divides(w, h, k) { return (w * 120) % k == 0 && (h * 120) % k == 0 }
  ' >"$1.tmp" && mv -f "$1.tmp" "$1"
}

if [ "${1:-}" = --update-monitors ]; then
  # omarchy.exe, mid-session: the Windows display layout changed. Rewrite the rules and reload Hyprland.
  RUNTIME=/run/user/$(id -u) # never XDG_RUNTIME_DIR blindly: without systemd it is WSLg's shared one
  [ -d "$RUNTIME" ] || exit 1
  mkdir -p "$RUNTIME/womarchy" "$LOG_DIR"
  write_monitor_rules "$RUNTIME/womarchy/monitors.lua" || exit 1
  inst=$(ls -td "$RUNTIME"/hypr/*/ 2>/dev/null | head -1)
  [ -n "$inst" ] && HYPRLAND_INSTANCE_SIGNATURE=$(basename "$inst") hyprctl reload >/dev/null 2>&1
  echo "[$(date +%T.%3N)] monitors changed: ${WOMARCHY_MONITORS:-}" >>"$LOG_DIR/session.log"
  exit 0
fi

mkdir -p "$LOG_DIR"
LOG=$LOG_DIR/session.log
[ -f "$LOG" ] && mv -f "$LOG" "$LOG.1"
# fd 3: stdout to omarchy.exe (handshake only); fd 4: the Windows console, for errors the user should see
exec 3>&1 4>&2 >>"$LOG" 2>&1
# omarchy.exe going away (killed, crashed) hangs us up; uwsm stops the compositor on the same signal, and
# we still want to finish below (a handler, unlike ignoring, is not inherited by uwsm)
HUNGUP=0
trap 'HUNGUP=1' HUP
say() { echo "[$(date +%T.%3N)] $*"; }
die() {
  say "fatal: $*"
  echo "womarchy-session: $* (log: $LOG)" >&4
  exit 1
}

say "womarchy-session starting: user $(id -un) ($(id -u)), distro ${WSL_DISTRO_NAME:-?}"
[ -n "${WOMARCHY_TOKEN:-}" ] && [ -n "${WOMARCHY_CLIP_TOKEN:-}" ] && [ -n "${WOMARCHY_VSOCK_PORT:-}" ] ||
  die "WOMARCHY_TOKEN/WOMARCHY_CLIP_TOKEN/WOMARCHY_VSOCK_PORT are not set; start Omarchy with omarchy.exe"
if [ "$(id -u)" = 0 ] && [ -e /usr/lib/womarchy/oobe.sh ] && [ ! -f /var/lib/womarchy/oobe-done ]; then
  # freshly installed image: WSL only runs its first-run setup for interactive shells, so omarchy.exe
  # runs it (it recognises this line and status 75) and starts us again
  say "first-run setup has not run yet"
  echo "WOMARCHY_NEEDS_SETUP" >&3
  exit 75
fi
[ "$(id -u)" != 0 ] || die "refusing to run the desktop as root; set a default user for this distro"

VMID=$(wslinfo --vm-id 2>/dev/null | tr -d '\r')
[ -n "$VMID" ] || die "wslinfo --vm-id failed (needs WSL 2.5 or newer)"
echo "WOMARCHY_VMID=$VMID" >&3
exec 3>&- # nothing else goes to omarchy.exe's pipe

RUNTIME=/run/user/$(id -u) # the systemd user runtime dir (WSLg's shared one when systemd is off)
[ -d "$RUNTIME" ] || die "$RUNTIME does not exist (is systemd enabled in /etc/wsl.conf?)"
export XDG_RUNTIME_DIR=$RUNTIME
systemctl --user show-environment >/dev/null 2>&1 ||
  die "the systemd user manager is not reachable (is systemd enabled in /etc/wsl.conf?)"

# One session at a time. omarchy.exe never starts a second viewer for a running desktop, so a held lock
# means the previous session is still winding down (its viewer went away): wait for it to end.
mkdir -p "$RUNTIME/womarchy"
exec 5>"$RUNTIME/womarchy/session.lock"
if ! flock -n 5; then
  say "waiting for the previous session to end"
  flock -w 45 5 || die "a previous Omarchy session is still running (log: $LOG_DIR/session.log.1)"
fi

# --- shared-memory share (zero-copy frames); without it the backend streams pixels over the socket
SHM=/mnt/wslgshm
if mountpoint -q "$SHM" && [ -w "$SHM" ]; then
  export WOMARCHY_SHM_DIR=$SHM
  say "frames: shared memory ($SHM)"
else
  unset WOMARCHY_SHM_DIR
  say "frames: inline over hvsocket ($SHM is not mounted; see mnt-wslgshm.mount)"
fi

# --- monitor rules for this launch
GEN_DIR=$RUNTIME/womarchy
mkdir -p "$GEN_DIR"
write_monitor_rules "$GEN_DIR/monitors.lua" || die "could not write $GEN_DIR/monitors.lua"
sed 's/^/  /' "$GEN_DIR/monitors.lua"

# --- environment for the compositor (uwsm hands the login environment to the systemd user manager)
unset DISPLAY WAYLAND_DISPLAY # WSLg's; the session runs its own
# Windows' PATH (appended by WSL interop) makes every command lookup crawl over /mnt/c
PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -v '^/mnt/' | paste -sd:)
export PATH
export HYPRLAND_BACKEND=wsl WOMARCHY_VM_ID=$VMID WOMARCHY_TOKEN WOMARCHY_CLIP_TOKEN WOMARCHY_VSOCK_PORT WOMARCHY_MONITORS
if [ -e /dev/dxg ]; then
  export GALLIUM_DRIVER=${GALLIUM_DRIVER:-d3d12} # Mesa picks llvmpipe on WSL unless told
else
  # no GPU paravirtualization (old driver, or GPU support off): Mesa falls back to software rendering
  say "no /dev/dxg: rendering in software"
  echo "womarchy-session: no GPU acceleration available (/dev/dxg missing); the desktop will be slow" >&4
fi
# if omarchy.exe goes away without saying goodbye (killed, crashed), nothing can reattach: end the session
export WOMARCHY_ORPHAN_TIMEOUT=${WOMARCHY_ORPHAN_TIMEOUT:-30}
export XDG_SESSION_TYPE=wayland XDG_SESSION_CLASS=user
# uwsm finds the login session by VT, which WSL has none of. `wsl --exec` processes are not inside a logind
# session either (cgroup /non-systemd), but WSL opens a "user" class session for the distro's user: use it.
if [ -z "${XDG_SESSION_ID:-}" ]; then
  XDG_SESSION_ID=$(sed -n 's|.*/session-\(.*\)\.scope$|\1|p' /proc/self/cgroup | head -1)
  [ -n "$XDG_SESSION_ID" ] ||
    XDG_SESSION_ID=$(loginctl list-sessions --no-legend 2>/dev/null | awk -v u="$(id -u)" '$2 == u && $6 == "user" { print $1; exit }')
fi
[ -n "$XDG_SESSION_ID" ] || die "no logind session found for $(id -un) (loginctl list-sessions)"
export XDG_SESSION_ID XDG_SEAT=${XDG_SEAT:-seat0}
say "login session $XDG_SESSION_ID, backend wsl, vsock port $WOMARCHY_VSOCK_PORT"
if [ -e /usr/lib/womarchy/oobe.sh ] && [ ! -f "$HOME/.local/state/womarchy/provisioned" ]; then
  # first-run setup could not finish Omarchy's per-user setup (e.g. no network at the time)
  echo "womarchy-session: Omarchy's user setup is incomplete; run  womarchy-provision-user  in a terminal to finish it" >&4
fi
FAILED_BEFORE=$(systemctl --user --failed --plain --no-legend 2>/dev/null | cut -d' ' -f1)

save_logs() {
  local d
  d=$(ls -td "$RUNTIME"/hypr/*/ 2>/dev/null | head -1)
  [ -n "$d" ] && [ -f "${d}hyprland.log" ] && cp -f "${d}hyprland.log" "$LOG_DIR/hyprland.log"
}

rc=0
if [ "${WOMARCHY_NO_UWSM:-0}" != 1 ] && command -v uwsm >/dev/null; then
  # A compositor without a womarchy-session holding the lock was started some other way (a terminal,
  # a crash leftover): it has no viewer, so replace it. (systemctl, not `uwsm check`: 0.8 s faster)
  if systemctl --user --quiet is-active wayland-wm@hyprland.desktop.service graphical-session.target; then
    say "a compositor session without a viewer is active; stopping it"
    uwsm stop >/dev/null 2>&1
  fi
  say "starting: uwsm start -g -1 -e -D Hyprland hyprland.desktop"
  uwsm start -g -1 -e -D Hyprland hyprland.desktop
  rc=$?
  # uwsm's own status says little (0 even when the environment preloader fails): ask the units.
  # A failed unit stays loaded with its result; a cleanly stopped one reports success/0.
  for unit in wayland-wm-env@hyprland.desktop.service wayland-wm@hyprland.desktop.service; do
    result=$(systemctl --user show -p Result --value "$unit" 2>/dev/null)
    status=$(systemctl --user show -p ExecMainStatus --value "$unit" 2>/dev/null)
    say "$unit: result=${result:-?} status=${status:-?}"
    if [ "${result:-success}" != success ] && [ "$rc" = 0 ]; then
      rc=${status:-1}
      [ "$rc" != 0 ] || rc=1
    fi
    systemctl --user reset-failed "$unit" >/dev/null 2>&1
  done
  say "uwsm returned; session status $rc"
  # Session services that die with the compositor (e.g. xdg-desktop-portal-gtk: "Lost connection to
  # Wayland compositor") would leave the user manager "degraded" until the next session; reset those
  # (and only those: failures from before the session stay visible).
  for unit in $(systemctl --user --failed --plain --no-legend 2>/dev/null | cut -d' ' -f1); do
    printf '%s\n' "$FAILED_BEFORE" | grep -qxF "$unit" || systemctl --user reset-failed "$unit" >/dev/null 2>&1
  done
  # uwsm restores the manager's environment on stop; make sure our secrets never linger there (unless
  # they already belong to a newer session)
  if systemctl --user show-environment | grep -qxF "WOMARCHY_TOKEN=$WOMARCHY_TOKEN"; then
    systemctl --user unset-environment WOMARCHY_TOKEN WOMARCHY_CLIP_TOKEN WOMARCHY_VSOCK_PORT WOMARCHY_MONITORS \
      WOMARCHY_VM_ID WOMARCHY_SHM_DIR HYPRLAND_BACKEND WOMARCHY_ORPHAN_TIMEOUT >/dev/null 2>&1
  fi
else
  say "starting: start-hyprland (without uwsm)"
  start-hyprland
  rc=$?
fi

save_logs
say "session ended with $rc"
[ "$HUNGUP" = 1 ] && say "omarchy.exe went away (hangup); the compositor was stopped"
trap '' PIPE # the console may be gone
if [ "$rc" != 0 ] && [ "$HUNGUP" = 0 ]; then
  echo "womarchy-session: the desktop session ended with status $rc (logs: $LOG_DIR)" >&4 2>/dev/null
fi
exit "$rc"
