# Maintainer: womarchy project
#
# womarchy-compat: lets the real `omarchy` package install on WSL, and carries
# the womarchy WSL overlay.
#  - `omarchy` (x86_64) hard-depends on limine, limine-mkinitcpio-hook,
#    limine-snapper-sync and snapper. WSL has no bootloader, initramfs or btrfs,
#    and Limine's own pacman hook fails every transaction there ("FAT32 boot
#    partition not found"). Providing them (and conflicting with the real ones)
#    satisfies the dependency without installing any of it. `omarchy-snapshot`
#    then exits 127, which `omarchy update` treats as "no snapshots".
#  - Kernels never belong in a WSL distro (WSL boots Microsoft's kernel).
#  - Overlay: womarchy-apply-system, womarchy-provision-user, womarchy-rollback,
#    the WSL leaves (/usr/lib/womarchy/wsl), user templates (/usr/lib/womarchy/user),
#    OOBE, and pacman hooks (rollback points, Mesa/LLVM guard, WSLg app hiding).
#
# Local source: prepare-sources.sh (run by linux/packages/build-all.sh) packs
# linux/overlay into womarchy-overlay.tar.gz next to this PKGBUILD.

pkgname=womarchy-compat
pkgver=0.4.1
pkgrel=2
pkgdesc='Omarchy on WSL: bootloader/snapshot stand-ins and the womarchy WSL overlay'
arch=(any)
url='https://github.com/sytelus/womarchy'
license=(MIT)
depends=(bash jq perl pacman systemd sudo iproute2 desktop-file-utils curl womarchy-keyring)
optdepends=('omarchy: the desktop this overlay adapts'
            'womarchy-session: Hyprland session launcher and shared-memory mount'
            'mesa-utils: eglinfo, used to confirm the d3d12 GPU path')
provides=(limine limine-mkinitcpio-hook limine-snapper-sync snapper)
conflicts=(limine limine-mkinitcpio-hook limine-snapper-sync snapper
           linux linux-omarchy linux-lts linux-zen linux-hardened)
source=(womarchy-overlay.tar.gz)
sha256sums=('SKIP')

package() {
  local o="$srcdir/womarchy-overlay" f

  install -Dm755 "$o/womarchy-apply-system" "$pkgdir/usr/bin/womarchy-apply-system"
  install -Dm755 "$o/womarchy-provision-user" "$pkgdir/usr/bin/womarchy-provision-user"
  install -Dm755 "$o/womarchy-rollback" "$pkgdir/usr/bin/womarchy-rollback"
  install -Dm755 "$o/oobe.sh" "$pkgdir/usr/lib/womarchy/oobe.sh"
  install -Dm644 "$o/omarchy.ico" "$pkgdir/usr/lib/womarchy/omarchy.ico"
  install -Dm755 "$o/wslg-hide-apps" "$pkgdir/usr/lib/womarchy/wslg-hide-apps"
  install -Dm755 "$o/rollback-point" "$pkgdir/usr/lib/womarchy/rollback-point"
  install -Dm755 "$o/mesa-llvm-guard" "$pkgdir/usr/lib/womarchy/mesa-llvm-guard"
  for f in "$o"/hooks/*.hook; do
    install -Dm644 "$f" "$pkgdir/usr/share/libalpm/hooks/${f##*/}"
  done
  # Fallbacks appended to the session PATH (real tools win): nm-online
  install -Dm755 "$o/bin/nm-online" "$pkgdir/usr/lib/womarchy/bin/nm-online"
  # GALLIUM_DRIVER=d3d12 for the user manager only when /dev/dxg exists
  install -Dm755 "$o/systemd/60-womarchy-gpu" "$pkgdir/usr/lib/systemd/user-environment-generators/60-womarchy-gpu"

  install -d "$pkgdir/usr/lib/womarchy/wsl"
  install -m644 "$o"/wsl/*.sh "$pkgdir/usr/lib/womarchy/wsl/"

  # User templates keep their relative layout (~/.config/<path>). Modes are set
  # here, not taken from the source tree (a Windows checkout marks everything +x).
  (cd "$o/user" && find . -type f) | while read -r f; do
    f=${f#./}
    case $f in
      omarchy/hooks/*) install -Dm755 "$o/user/$f" "$pkgdir/usr/lib/womarchy/user/$f" ;;
      *) install -Dm644 "$o/user/$f" "$pkgdir/usr/lib/womarchy/user/$f" ;;
    esac
  done
}
