#!/bin/bash

# womarchy-apply-system: WSL-filtered replacement for omarchy-apply-system.
#
# Same interface, environment and logging as upstream bin/omarchy-apply-system,
# but instead of sourcing install/{config,hardware,login,post-install}/all.sh
# wholesale it walks their run_logged lines through a skip list, then runs the
# womarchy WSL leaves from /usr/lib/womarchy/wsl/.
#
# Policy (docs/research/01-omarchy.md §7, §10.5):
#   config/, post-install/  default-allow, minus WOMARCHY_SKIP
#   hardware/, login/       default-deny (nothing in them applies to WSL)
# A new upstream leaf in config/ or post-install/ therefore runs automatically;
# a CI job that diffs upstream all.sh files on each Omarchy release and flags
# unclassified leaves is planned (PLAN.md Phase 2, item 7), not yet in place.
# A line in an all.sh that is not a plain `run_logged "$OMARCHY_INSTALL/..."`
# call stops the run with an error rather than being guessed at.
#
# Settings come from /etc/womarchy/config (WOMARCHY_DOCKER, WOMARCHY_FIREWALL,
# WOMARCHY_REPO_URL: the hosted [womarchy] repo, default the GitHub `packages` release).
# A value given in the environment overrides the file and is saved to it, so the
# post-update hook (whose sudo resets the environment) keeps honouring it.

set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: womarchy-apply-system --install-user USER [--first-install|--upgrade]
       womarchy-apply-system --defer-provisioning --first-install   (image build: no user yet)
       womarchy-apply-system --reassert       (WSL leaves only; run by the update hooks)
       womarchy-apply-system --list           (print the plan, run nothing)

Environment / /etc/womarchy/config:
  WOMARCHY_DOCKER=1|0     enable docker.socket (0: Docker Desktop's WSL integration)
  WOMARCHY_FIREWALL=0|1   1: run Omarchy's config/firewall.sh (ufw) and stop masking ufw
  WOMARCHY_REPO_URL=URL   the hosted [womarchy] repo (https://... or file:///...; a mirror or fork)
  WOMARCHY_SKIP_EXTRA="config/foo.sh ..."   skip more upstream leaves (this run only)
USAGE
}

install_user="${OMARCHY_INSTALL_USER:-}"
first_install=0 upgrade=0 defer_provisioning=0 reassert=0 list_only=0

while (($#)); do
  case "$1" in
    --install-user) install_user="${2:-}"; shift; (($#)) && shift ;;
    --defer-provisioning) defer_provisioning=1; shift ;;
    --first-install) first_install=1; shift ;;
    --upgrade) upgrade=1; shift ;;
    --reassert) reassert=1; shift ;;
    --list) list_only=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
  esac
done

export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
export OMARCHY_INSTALL="${OMARCHY_INSTALL:-$OMARCHY_PATH/install}"
export WOMARCHY_LIB="${WOMARCHY_LIB:-/usr/lib/womarchy}"
export OMARCHY_MIRROR="${OMARCHY_MIRROR:-stable}"

# --- settings: environment > /etc/womarchy/config > default ---------------------------
CONFIG=/etc/womarchy/config
declare -A DEFAULTS=([WOMARCHY_DOCKER]=1 [WOMARCHY_FIREWALL]=0
                     [WOMARCHY_REPO_URL]=https://github.com/sytelus/womarchy/releases/download/packages)
valid_setting() { # KEY VALUE
  case $1 in
    WOMARCHY_DOCKER|WOMARCHY_FIREWALL) [[ $2 == [01] ]] ;;
    WOMARCHY_REPO_URL) [[ $2 =~ ^(https://[A-Za-z0-9.-]+|file://)/[A-Za-z0-9._~/%+-]*$ ]] ;;
    *) return 1 ;;
  esac
}
config_value() { # last valid KEY=VALUE line of the file (invalid ones are ignored)
  [[ -f $CONFIG ]] || return 0
  local v
  v=$(sed -n "s/^$1=//p" "$CONFIG" | tail -n1)
  v=${v%"${v##*[![:space:]]}"}
  if [[ -n $v ]] && ! valid_setting "$1" "$v"; then
    echo "warning: ignoring invalid $1='$v' in $CONFIG" >&2
    return 0
  fi
  printf '%s' "$v"
}
save_config() { # KEY VALUE (VALUE already validated; no sed: URLs contain / and &)
  install -d -m 0755 "${CONFIG%/*}"
  [[ -f $CONFIG ]] || install -m 0644 /dev/null "$CONFIG"
  local tmp
  tmp=$(mktemp "$CONFIG.XXXXXX")
  awk -v k="$1" -v v="$2" 'index($0, k "=") == 1 { if (!done) print k "=" v; done = 1; next } { print }
    END { if (!done) print k "=" v }' "$CONFIG" >"$tmp" && chmod 0644 "$tmp" && mv -f "$tmp" "$CONFIG"
}
for key in "${!DEFAULTS[@]}"; do
  value=${!key:-}
  if [[ -n $value ]]; then
    valid_setting "$key" "$value" || { echo "Error: invalid $key='$value'" >&2; exit 1; }
    if (( EUID == 0 && ! list_only )) && [[ $(config_value "$key") != "$value" ]]; then save_config "$key" "$value"; fi
  else
    value=$(config_value "$key")
    value=${value:-${DEFAULTS[$key]}}
  fi
  export "$key=$value"
done

# Upstream leaves skipped under WSL. Everything else in config/ and post-install/ runs.
WOMARCHY_SKIP=(
  config/snapper.sh          # no btrfs; snapper is provided (not installed) by womarchy-compat
  config/enable-services.sh  # replaced by wsl/enable-services.sh
)
# Hyper-V firewall + WSL NAT already gate inbound traffic; ufw is opt-in.
[[ $WOMARCHY_FIREWALL == 1 ]] || WOMARCHY_SKIP+=(config/firewall.sh)
read -r -a _extra <<<"${WOMARCHY_SKIP_EXTRA:-}"
WOMARCHY_SKIP+=("${_extra[@]}")

# WSL leaves, in order. pacman.sh must follow post-install/pacman.sh, which
# rewrites /etc/pacman.conf from Omarchy's template.
WSL_LEAVES=(binfmt.sh pacman.sh enable-services.sh gpu.sh audio.sh keyboard-locale.sh docker-dns.sh shm-mount.sh
            wslg-apps.sh)

skipped() {
  local leaf="$1" s
  case $leaf in hardware/*|login/*) return 0 ;; esac
  for s in "${WOMARCHY_SKIP[@]}"; do [[ $leaf == "$s" ]] && return 0; done
  return 1
}

# Print the leaf paths (relative to $OMARCHY_INSTALL) that an all.sh would run.
# Fails on any line it does not understand.
leaves_of() {
  local file=$OMARCHY_INSTALL/$1/all.sh line
  [[ -f $file ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line =~ ^[[:space:]]*(#.*)?$ ]] && continue
    if [[ $line =~ ^[[:space:]]*run_logged[[:space:]]+\"\$OMARCHY_INSTALL/([A-Za-z0-9_./-]+\.sh)\"[[:space:]]*$ &&
          ${BASH_REMATCH[1]} != *..* ]]; then
      echo "${BASH_REMATCH[1]}"
    else
      echo "womarchy-apply-system: cannot classify this line of $file:" >&2
      echo "  $line" >&2
      return 1
    fi
  done <"$file"
}

# The plan: "run <leaf>" / "skip <leaf>" for every upstream leaf.
plan=()
for phase in config hardware login post-install; do
  leaves=$(leaves_of "$phase") || exit 1
  while IFS= read -r leaf; do
    [[ -n $leaf ]] || continue
    if skipped "$leaf"; then plan+=("skip $leaf"); else plan+=("run $leaf"); fi
  done <<<"$leaves"
done

if (( list_only )); then
  printf '%s\n' "${plan[@]}" | sed 's/^run /run   /; s/^skip /skip  /'
  for leaf in "${WSL_LEAVES[@]}"; do echo "run   wsl/$leaf"; done
  exit 0
fi

if (( EUID != 0 )); then
  echo "Error: womarchy-apply-system must run as root" >&2
  exit 1
fi

if (( ! reassert )); then
  if (( defer_provisioning )); then
    install_user=""
  elif [[ -z $install_user || $install_user == root ]]; then
    echo "Error: --install-user must name the target non-root user (or use --defer-provisioning)" >&2
    exit 1
  elif ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export OMARCHY_INSTALL_USER="$install_user"
export OMARCHY_FIRST_INSTALL="$first_install"
export OMARCHY_UPGRADE="$upgrade"
export OMARCHY_INSTALL_LOG_FILE="${OMARCHY_INSTALL_LOG_FILE:-/var/log/omarchy-install.log}"
export PATH="$OMARCHY_PATH/bin:$PATH"

# Omarchy's start_install_log makes the log world-writable (0666, for its
# user-run steps); womarchy's user steps log elsewhere, so close it again.
tighten_log() {
  if [[ -f $OMARCHY_INSTALL_LOG_FILE ]]; then chmod 0640 "$OMARCHY_INSTALL_LOG_FILE" 2>/dev/null || true; fi
}
trap tighten_log EXIT

source "$OMARCHY_INSTALL/helpers/logging.sh"
start_install_log

failed=()
run_leaf() {
  # Like upstream, a failing leaf is logged; unlike upstream (set -e aborts the
  # whole apply), we finish the remaining leaves and report at the end.
  run_logged "$1" || failed+=("${1#"$OMARCHY_INSTALL/"}")
}

if (( ! reassert )); then
  for step in "${plan[@]}"; do
    leaf=${step#* }
    if [[ $step == skip* ]]; then
      omarchy_log_line "[$(date '+%Y-%m-%d %H:%M:%S')] Skipped (womarchy): $OMARCHY_INSTALL/$leaf"
    else
      run_leaf "$OMARCHY_INSTALL/$leaf"
    fi
  done
fi

for leaf in "${WSL_LEAVES[@]}"; do
  run_leaf "$WOMARCHY_LIB/wsl/$leaf"
done

stop_install_log
tighten_log

if ((${#failed[@]})); then
  echo "womarchy-apply-system: failed leaves: ${failed[*]} (see $OMARCHY_INSTALL_LOG_FILE)" >&2
  exit 1
fi
