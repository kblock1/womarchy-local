#!/bin/bash
# womarchy fallback nm-online for WSL, where NetworkManager is not installed:
# Windows owns the network, so there is never Wi-Fi to set up here.
# Omarchy's first run (install/user/first-run/wifi.sh) calls nm-online and shows
# "Setup Wi-Fi" when it fails; this reports "online" instead, so only the
# "Update System" toast appears. Lives in /usr/lib/womarchy/bin, which the
# session appends to PATH, so a real /usr/bin/nm-online always wins.
# Accepts nm-online's options; waits (up to -t, default 30 s) for a default
# route unless -s/-x, and always exits 0.
timeout=30 wait_route=1
while (($#)); do
  case "$1" in
    -t|--timeout)
      shift
      if [[ ${1:-} =~ ^[0-9]+$ ]]; then timeout=$1; shift; fi ;;
    --timeout=*) timeout=${1#*=}; shift ;;
    -s|--wait-for-startup|-x|--exit) wait_route=0; shift ;;
    -q|--quiet) shift ;;
    -[a-z]*) # combined short flags, e.g. -qs, -qx, -qt 30
      flags=${1#-}
      shift
      [[ $flags == *[sx]* ]] && wait_route=0
      if [[ $flags == *t && ${1:-} =~ ^[0-9]+$ ]]; then timeout=$1; shift; fi ;;
    *) shift ;;
  esac
done
[[ $timeout =~ ^[0-9]+$ ]] || timeout=30
if (( wait_route )); then
  for ((i = 0; i < timeout; i++)); do
    ip route show default 2>/dev/null | grep -q . && break
    ip -6 route show default 2>/dev/null | grep -q . && break
    sleep 1
  done
fi
exit 0
