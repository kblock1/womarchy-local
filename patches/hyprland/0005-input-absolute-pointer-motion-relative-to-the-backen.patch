From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Shital Shah <2096835+sytelus@users.noreply.github.com>
Date: Wed, 30 Sep 2026 21:53:57 -0700
Subject: [PATCH 5/5] input: absolute pointer motion relative to the backend's
 output

aquamarine's IPointer::SWarpEvent carries the output its absolute (0..1) position refers to, but
Hyprland dropped it and mapped mouse warps onto the whole monitor layout. With one output that is
the same thing; with several (a nested or remote backend showing one window per output) the pointer
landed on the wrong monitor, e.g. the centre of the third of three monitors mapped to the centre of
the second. Pass the output through and, for pointers, map into that monitor's logical box.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/devices/IPointer.hpp            |  4 ++++
 src/devices/Mouse.cpp               |  1 +
 src/managers/input/InputManager.cpp |  2 +-
 src/pointer/PointerManager.cpp      | 12 ++++++++++--
 src/pointer/PointerManager.hpp      |  3 ++-
 5 files changed, 18 insertions(+), 4 deletions(-)

diff --git a/src/devices/IPointer.hpp b/src/devices/IPointer.hpp
index 197ba12..0c07e86 100644
--- a/src/devices/IPointer.hpp
+++ b/src/devices/IPointer.hpp
@@ -5,6 +5,7 @@
 #include "../helpers/math/Math.hpp"
 
 AQUAMARINE_FORWARD(IPointer);
+AQUAMARINE_FORWARD(IOutput);
 
 /*
     Base class for a pointer.
@@ -27,6 +28,9 @@ class IPointer : public IHID {
         uint32_t timeMs = 0;
         Vector2D absolute; // 0.0 - 1.0
         SP<IHID> device;
+        // the output `absolute` is relative to, when the backend knows it (e.g. a nested or remote
+        // backend with one window per output); otherwise it spans the whole layout
+        SP<Aquamarine::IOutput> output;
     };
 
     struct SButtonEvent {
diff --git a/src/devices/Mouse.cpp b/src/devices/Mouse.cpp
index 403b089..996ade0 100644
--- a/src/devices/Mouse.cpp
+++ b/src/devices/Mouse.cpp
@@ -39,6 +39,7 @@ CMouse::CMouse(SP<Aquamarine::IPointer> mouse_) : m_mouse(mouse_) {
             .timeMs   = event.timeMs,
             .absolute = event.absolute,
             .device   = m_self.lock(),
+            .output   = event.output.lock(),
         });
     });
 
diff --git a/src/managers/input/InputManager.cpp b/src/managers/input/InputManager.cpp
index 187dbe8..27b0b33 100644
--- a/src/managers/input/InputManager.cpp
+++ b/src/managers/input/InputManager.cpp
@@ -171,7 +171,7 @@ void CInputManager::onMouseMoved(IPointer::SMotionEvent e) {
 }
 
 void CInputManager::onMouseWarp(IPointer::SMotionAbsoluteEvent e) {
-    Pointer::mgr()->warpAbsolute(e.absolute, e.device);
+    Pointer::mgr()->warpAbsolute(e.absolute, e.device, e.output);
 
     mouseMoveUnified(e.timeMs);
 
diff --git a/src/pointer/PointerManager.cpp b/src/pointer/PointerManager.cpp
index fd78f58..c6c01df 100644
--- a/src/pointer/PointerManager.cpp
+++ b/src/pointer/PointerManager.cpp
@@ -846,7 +846,7 @@ void CPointerManager::move(const Vector2D& deltaLogical) {
     warpTo(newPos);
 }
 
-void CPointerManager::warpAbsolute(Vector2D abs, SP<IHID> dev) {
+void CPointerManager::warpAbsolute(Vector2D abs, SP<IHID> dev, SP<Aquamarine::IOutput> output) {
     if (!dev || State::monitorState()->monitors().empty())
         return;
 
@@ -907,7 +907,15 @@ void CPointerManager::warpAbsolute(Vector2D abs, SP<IHID> dev) {
         }
         case HID_TYPE_POINTER: {
             IPointer* POINTER = rc<IPointer*>(dev.get());
-            if (!POINTER->m_boundOutput.empty())
+            if (output) {
+                // the backend says which output the position is on (e.g. one remote window per output)
+                for (auto const& m : MONITORS) {
+                    if (m->m_output == output) {
+                        mappedArea = m->logicalBox();
+                        break;
+                    }
+                }
+            } else if (!POINTER->m_boundOutput.empty())
                 mappedArea = outputMappedArea(POINTER->m_boundOutput);
             break;
         }
diff --git a/src/pointer/PointerManager.hpp b/src/pointer/PointerManager.hpp
index 867473f..074240f 100644
--- a/src/pointer/PointerManager.hpp
+++ b/src/pointer/PointerManager.hpp
@@ -42,7 +42,8 @@ namespace Pointer {
         // only clamps to the layout.
         void warpTo(const Vector2D& logical);
         void move(const Vector2D& deltaLogical);
-        void warpAbsolute(Vector2D abs, SP<IHID> dev);
+        // `output`: the output `abs` is relative to (pointers only); null = the whole layout
+        void warpAbsolute(Vector2D abs, SP<IHID> dev, SP<Aquamarine::IOutput> output = nullptr);
 
         void setCursorBuffer(SP<Aquamarine::IBuffer> buf, const Vector2D& hotspot, const float& scale);
         void setCursorSurface(SP<Desktop::View::CWLSurface> buf, const Vector2D& hotspot);
