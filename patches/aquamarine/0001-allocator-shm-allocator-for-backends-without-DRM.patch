diff --git a/include/aquamarine/allocator/Shm.hpp b/include/aquamarine/allocator/Shm.hpp
new file mode 100644
index 0000000..995deb3
--- /dev/null
+++ b/include/aquamarine/allocator/Shm.hpp
@@ -0,0 +1,75 @@
+#pragma once
+
+#include "Allocator.hpp"
+#include <hyprutils/memory/WeakPtr.hpp>
+#include <hyprutils/os/FileDescriptor.hpp>
+#include <string>
+
+namespace Aquamarine {
+    class CShmAllocator;
+    class CBackend;
+    class CSwapchain;
+
+    /*
+        A CPU-memory buffer. Renderers that cannot scan out or share GPU buffers (no DRM device,
+        e.g. WSL2) render offscreen and read back into it. Backed either by a memfd, or by a file
+        in a caller-provided directory (e.g. a shared-memory filesystem another process maps).
+    */
+    class CShmBuffer : public IBuffer {
+      public:
+        virtual ~CShmBuffer();
+
+        virtual eBufferCapability                      caps();
+        virtual eBufferType                            type();
+        virtual void                                   update(const Hyprutils::Math::CRegion& damage);
+        virtual bool                                   isSynchronous();
+        virtual bool                                   good();
+        virtual SSHMAttrs                              shm();
+        virtual std::tuple<uint8_t*, uint32_t, size_t> beginDataPtr(uint32_t flags);
+        virtual void                                   endDataPtr();
+
+        // leaf file name when file-backed, empty for memfd buffers
+        const std::string& fileName() const;
+        uint8_t*           data() const;
+        uint32_t           stride() const;
+        uint32_t           format() const;
+
+      private:
+        CShmBuffer(const SAllocatorBufferParams& params, Hyprutils::Memory::CWeakPointer<CShmAllocator> allocator_);
+
+        Hyprutils::Memory::CWeakPointer<CShmAllocator> allocator;
+        Hyprutils::OS::CFileDescriptor                 fd;
+        uint8_t*                                       ptr        = nullptr;
+        size_t                                         bufferSize = 0; // stride * height
+        size_t                                         mapSize    = 0; // bufferSize rounded up to whole pages
+        uint32_t                                       bufStride  = 0;
+        uint32_t                                       bufFormat  = 0;
+        std::string                                    path, leafName;
+
+        friend class CShmAllocator;
+    };
+
+    class CShmAllocator : public IAllocator {
+      public:
+        // dir: where to create buffer files; empty = anonymous memfd. prefix: file name prefix.
+        static Hyprutils::Memory::CSharedPointer<CShmAllocator> create(Hyprutils::Memory::CSharedPointer<CBackend> backend_, const std::string& dir = "",
+                                                                       const std::string& prefix = "aq");
+        virtual ~CShmAllocator() = default;
+
+        virtual Hyprutils::Memory::CSharedPointer<IBuffer>  acquire(const SAllocatorBufferParams& params, Hyprutils::Memory::CSharedPointer<CSwapchain> swapchain_);
+        virtual Hyprutils::Memory::CSharedPointer<CBackend> getBackend();
+        virtual int                                         drmFD();
+        virtual eAllocatorType                              type();
+
+        Hyprutils::Memory::CWeakPointer<CShmAllocator>      self;
+
+      private:
+        CShmAllocator(Hyprutils::Memory::CSharedPointer<CBackend> backend_, const std::string& dir, const std::string& prefix);
+
+        Hyprutils::Memory::CWeakPointer<CBackend> backend;
+        std::string                               directory, namePrefix;
+        uint64_t                                  counter = 0;
+
+        friend class CShmBuffer;
+    };
+};
diff --git a/src/allocator/Shm.cpp b/src/allocator/Shm.cpp
new file mode 100644
index 0000000..29811f7
--- /dev/null
+++ b/src/allocator/Shm.cpp
@@ -0,0 +1,176 @@
+#include <aquamarine/allocator/Shm.hpp>
+#include <aquamarine/backend/Backend.hpp>
+#include <aquamarine/allocator/Swapchain.hpp>
+#include "FormatUtils.hpp"
+#include "Shared.hpp"
+#include <cerrno>
+#include <cstring>
+#include <fcntl.h>
+#include <format>
+#include <sys/mman.h>
+#include <unistd.h>
+
+using namespace Aquamarine;
+using namespace Hyprutils::Memory;
+using namespace Hyprutils::Math;
+#define SP CSharedPointer
+#define WP CWeakPointer
+
+static uint32_t shmFormatFor(uint32_t requested) {
+    // CPU buffers are always 8-bit BGRX/BGRA in memory, which every consumer (wl_shm, DXGI B8G8R8A8) takes.
+    if (requested == DRM_FORMAT_ARGB8888)
+        return DRM_FORMAT_ARGB8888;
+    return DRM_FORMAT_XRGB8888;
+}
+
+Aquamarine::CShmBuffer::CShmBuffer(const SAllocatorBufferParams& params, WP<CShmAllocator> allocator_) : allocator(allocator_) {
+    size       = params.size; // validated by CShmAllocator::acquire
+    bufFormat  = shmFormatFor(params.format);
+    bufStride  = (uint32_t)size.x * 4; // tightly packed rows: CPU writers (e.g. cairo cursor path) assume it
+    bufferSize = (size_t)bufStride * (size_t)size.y;
+    // WSLg's DAX share rejects sizes that are not whole pages (EINVAL), e.g. 800x450 or 1366x768
+    const size_t PAGE = (size_t)sysconf(_SC_PAGESIZE);
+    mapSize           = (bufferSize + PAGE - 1) / PAGE * PAGE;
+
+    auto backend = allocator->getBackend();
+
+    if (allocator->directory.empty()) {
+        fd = Hyprutils::OS::CFileDescriptor{memfd_create("aq-shm", MFD_CLOEXEC)};
+        if (!fd.isValid() || ftruncate(fd.get(), (off_t)mapSize) != 0) {
+            backend->log(AQ_LOG_ERROR, std::format("shm: memfd allocation of {} bytes failed: {}", mapSize, strerror(errno)));
+            return;
+        }
+    } else {
+        leafName = std::format("{}-{}-{}-{}x{}", allocator->namePrefix, getpid(), ++allocator->counter, (int)size.x, (int)size.y);
+        path     = allocator->directory + "/" + leafName;
+        fd       = Hyprutils::OS::CFileDescriptor{open(path.c_str(), O_RDWR | O_CREAT | O_EXCL | O_CLOEXEC, 0600)};
+        if (!fd.isValid()) {
+            backend->log(AQ_LOG_ERROR, std::format("shm: creating {} failed: {}", path, strerror(errno)));
+            return;
+        }
+        // Section-backed filesystems (WSLg's virtio-fs DAX share) only support sizing via fallocate. There a
+        // file disappears when its last fd/mapping closes, so a crashed process leaves nothing behind.
+        if (fallocate(fd.get(), 0, 0, (off_t)mapSize) != 0 && ftruncate(fd.get(), (off_t)mapSize) != 0) {
+            backend->log(AQ_LOG_ERROR, std::format("shm: sizing {} to {} bytes failed: {}", path, mapSize, strerror(errno)));
+            unlink(path.c_str());
+            path.clear();
+            fd.reset();
+            return;
+        }
+    }
+
+    void* map = mmap(nullptr, mapSize, PROT_READ | PROT_WRITE, MAP_SHARED, fd.get(), 0);
+    if (map == MAP_FAILED) {
+        backend->log(AQ_LOG_ERROR, std::format("shm: mmap of {} bytes failed: {}", mapSize, strerror(errno)));
+        return;
+    }
+
+    ptr = static_cast<uint8_t*>(map);
+
+    // Write every page once now: on DAX-backed shares the first write to a page is several hundred times
+    // slower than later ones, and that cost belongs here rather than in the first frames. (Not
+    // MAP_POPULATE: on a shared mapping it only read-faults, so the write faults would come on top.)
+    memset(ptr, 0, mapSize);
+    backend->log(AQ_LOG_DEBUG, std::format("shm: allocated {} {} buffer ({} bytes){}", size, fourccToName(bufFormat), bufferSize, path.empty() ? "" : " at " + path));
+}
+
+Aquamarine::CShmBuffer::~CShmBuffer() {
+    events.destroy.emit();
+    if (ptr)
+        munmap(ptr, mapSize);
+    if (!path.empty())
+        unlink(path.c_str());
+}
+
+eBufferCapability Aquamarine::CShmBuffer::caps() {
+    return BUFFER_CAPABILITY_DATAPTR;
+}
+
+eBufferType Aquamarine::CShmBuffer::type() {
+    return BUFFER_TYPE_SHM;
+}
+
+void Aquamarine::CShmBuffer::update(const CRegion& damage) {
+    ;
+}
+
+bool Aquamarine::CShmBuffer::isSynchronous() {
+    return true;
+}
+
+bool Aquamarine::CShmBuffer::good() {
+    return ptr != nullptr;
+}
+
+SSHMAttrs Aquamarine::CShmBuffer::shm() {
+    return SSHMAttrs{
+        .success = ptr != nullptr,
+        .fd      = fd.get(),
+        .format  = bufFormat,
+        .size    = size,
+        .stride  = (int)bufStride,
+        .offset  = 0,
+    };
+}
+
+std::tuple<uint8_t*, uint32_t, size_t> Aquamarine::CShmBuffer::beginDataPtr(uint32_t flags) {
+    return {ptr, bufFormat, bufferSize};
+}
+
+void Aquamarine::CShmBuffer::endDataPtr() {
+    ;
+}
+
+const std::string& Aquamarine::CShmBuffer::fileName() const {
+    return leafName;
+}
+
+uint8_t* Aquamarine::CShmBuffer::data() const {
+    return ptr;
+}
+
+uint32_t Aquamarine::CShmBuffer::stride() const {
+    return bufStride;
+}
+
+uint32_t Aquamarine::CShmBuffer::format() const {
+    return bufFormat;
+}
+
+SP<CShmAllocator> Aquamarine::CShmAllocator::create(SP<CBackend> backend_, const std::string& dir, const std::string& prefix) {
+    auto a  = SP<CShmAllocator>(new CShmAllocator(backend_, dir, prefix));
+    a->self = a;
+    backend_->log(AQ_LOG_DEBUG, std::format("shm: created a shm allocator ({})", dir.empty() ? "memfd" : dir));
+    return a;
+}
+
+Aquamarine::CShmAllocator::CShmAllocator(SP<CBackend> backend_, const std::string& dir, const std::string& prefix) : backend(backend_), directory(dir), namePrefix(prefix) {
+    ;
+}
+
+SP<IBuffer> Aquamarine::CShmAllocator::acquire(const SAllocatorBufferParams& params, SP<CSwapchain> swapchain_) {
+    // generous for any real output or cursor, and keeps stride/size arithmetic far from overflow
+    constexpr double MAXDIM = 32768;
+    if (params.size.x < 1 || params.size.y < 1 || params.size.x > MAXDIM || params.size.y > MAXDIM) {
+        backend->log(AQ_LOG_ERROR, std::format("shm: refusing to allocate a buffer of size {}", params.size));
+        return nullptr;
+    }
+
+    auto buf = SP<CShmBuffer>(new CShmBuffer(params, self));
+    if (!buf->good())
+        return nullptr;
+
+    return buf;
+}
+
+SP<CBackend> Aquamarine::CShmAllocator::getBackend() {
+    return backend.lock();
+}
+
+int Aquamarine::CShmAllocator::drmFD() {
+    return -1;
+}
+
+eAllocatorType Aquamarine::CShmAllocator::type() {
+    return AQ_ALLOCATOR_TYPE_SHM;
+}
diff --git a/src/allocator/Swapchain.cpp b/src/allocator/Swapchain.cpp
index edc4aff..d2ca748 100644
--- a/src/allocator/Swapchain.cpp
+++ b/src/allocator/Swapchain.cpp
@@ -52,7 +52,7 @@ bool Aquamarine::CSwapchain::reconfigure(const SSwapchainOptions& options_) {
 
     options = options_;
     if (options.format == DRM_FORMAT_INVALID)
-        options.format = buffers.at(0)->dmabuf().format;
+        options.format = buffers.at(0)->dmabuf().success ? buffers.at(0)->dmabuf().format : buffers.at(0)->shm().format;
 
     allocator->getBackend()->log(AQ_LOG_DEBUG,
                                  std::format("Swapchain: Reconfigured a swapchain to {} {} of length {}", options.size, fourccToName(options.format), options.length));
