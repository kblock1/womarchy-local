+// womarchy: environments without KMS (e.g. WSL2) can still offer a render node
+// (vgem) that Mesa can drive through GBM. Let the headless backend expose it so
+// an allocator can be created when no DRM/Wayland backend provides one.
+static int headlessRenderNodeFD() {
+    static int fd = [] {
+        const char* path = getenv("AQ_HEADLESS_RENDER_NODE");
+        return path && *path ? open(path, O_RDWR | O_CLOEXEC) : -1;
+    }();
+    return fd;
+}
+
 int Aquamarine::CHeadlessBackend::drmFD() {
-    return -1;
+    return headlessRenderNodeFD();
 }
 
